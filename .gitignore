# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# OS
.DS_Store

# Editor
.idea/
.vscode/

# Env files (opt-in to committing as needed)
.env*

# Logs
*.log

# Safety: don't track any incidental Next.js artifacts if someone runs the old toolchain
/.next/

# Rails (when integrated into a full Rails app)
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets

# bundler / ruby
.bundle
vendor/bundle

# Node (only if you wire JS via jsbundling-rails)
/node_modules
