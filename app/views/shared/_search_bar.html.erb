<%#
  Locals:
    placeholder (default: "Search by products, vendor or SKU")
  Driven by search_bar_controller — pulls index from a JSON blob rendered server-side.
%>
<%
  placeholder ||= "Search by products, vendor or SKU"
  # Build a flat searchable index from all vendors and their (non-shipping-fee) products.
  # In production, expose this via an API endpoint and fetch lazily.
  search_index = Vendor.all.flat_map do |vendor|
    [
      {
        type: "vendor", id: vendor.id, name: vendor.name,
        subtitle: vendor.location, category: vendor.categories&.first || "",
        href: vendor_path(vendor.id), image: vendor.logo,
      },
    ] + vendor.products.reject(&:shipping_fee?).map do |product|
      {
        type: "product", id: product.id, name: product.name,
        subtitle: vendor.name, category: product.category,
        href: vendor_product_path(vendor.id, product.id),
        image: product.image, price: product.wholesale_unit_price, size: product.size,
      }
    end
  end
%>

<div data-controller="search-bar"
     data-search-bar-index-value="<%= search_index.to_json %>"
     class="relative flex-1 w-full">

  <%# Input %>
  <div data-search-bar-target="inputContainer"
       class="flex items-center gap-[6px] bg-white border rounded-full pl-[10px] pr-[6px] w-full border-[#a1a4aa] hover:border-[#777] transition-all duration-200"
       style="height: 38px">
    <img src="/icons/icon_search.svg" alt=""
         data-search-bar-target="searchIcon"
         class="shrink-0 opacity-60 transition-opacity"
         style="width: 14px; height: 14px">
    <input data-search-bar-target="input"
           data-action="input->search-bar#query focus->search-bar#focus blur->search-bar#blur keydown->search-bar#keyDown"
           type="text"
           placeholder="<%= placeholder %>"
           class="flex-1 bg-transparent text-[#444955] placeholder-[#737780] outline-none font-['Lato'] min-w-0 text-[14px]">
    <button data-search-bar-target="clearButton"
            data-action="click->search-bar#clear"
            class="hidden rounded-full bg-[#e8e8e8] items-center justify-center shrink-0 hover:bg-[#d0d0d0] transition-colors w-[16px] h-[16px]">
      <span class="text-[#777] leading-none text-[10px]">✕</span>
    </button>
  </div>

  <%# Dropdown %>
  <div data-search-bar-target="dropdown"
       data-transition="fade-down"
       class="absolute top-[42px] left-0 bg-white rounded-2xl overflow-hidden z-50
              shadow-[0_12px_40px_rgba(0,0,0,0.14)] border border-[#e8e8e8]
              w-[480px] max-w-[calc(100vw-2rem)]">
    <div data-search-bar-target="results"></div>
    <div data-search-bar-target="empty" class="hidden px-4 py-8 text-center">
      <div class="w-10 h-10 rounded-full bg-[#f7f5ef] flex items-center justify-center mx-auto mb-3">
        <img src="/icons/icon_search.svg" alt="" class="w-5 h-5 opacity-40">
      </div>
      <p class="font-bold text-[#444955] text-[13px]">No results for "<span data-search-bar-target="emptyQuery"></span>"</p>
      <p class="text-[#a1a4aa] mt-1 text-[11px]">Try a product name, vendor, or category</p>
    </div>
    <div class="px-4 py-2.5 border-t border-[#f0f0f0] bg-[#fafafa] flex items-center gap-3">
      <span class="flex items-center gap-1 text-[#a1a4aa] text-[10px]">
        <kbd class="bg-white border border-[#e8e8e8] rounded px-1.5 py-0.5 font-mono shadow-sm text-[10px]">↵</kbd> select
      </span>
      <span class="flex items-center gap-1 text-[#a1a4aa] text-[10px]">
        <kbd class="bg-white border border-[#e8e8e8] rounded px-1.5 py-0.5 font-mono shadow-sm text-[10px]">↑↓</kbd> navigate
      </span>
      <span class="flex items-center gap-1 text-[#a1a4aa] text-[10px]">
        <kbd class="bg-white border border-[#e8e8e8] rounded px-1.5 py-0.5 font-mono shadow-sm text-[10px]">esc</kbd> close
      </span>
    </div>
  </div>
</div>
