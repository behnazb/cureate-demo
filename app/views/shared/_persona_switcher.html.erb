<%#
  Persona switcher (E0) — sits where the signed-in user's identity + auth menu
  would live in production. In the prototype, clicking it flips Buyer ⇄ Vendor.

  Buyer  = Johns Hopkins University (buyer@jhu.edu)
  Vendor = 2Betties — an existing vendor in the buyer marketplace, so switching
           shows the same purchase orders from the other side of the table.

  This is a prototype affordance, not a product feature. It is styled to read as
  "dev toggle", not "user setting": a subtle switch icon on hover, no chrome.
%>
<div class="relative px-3 pb-1" data-controller="persona-switcher">

  <%# Flyout — opens upward, since this lives at the bottom of the sidebar %>
  <div data-persona-switcher-target="menu"
       data-open="false"
       class="absolute bottom-full left-3 right-3 mb-2 rounded-lg overflow-hidden bg-white shadow-[0_8px_24px_rgba(0,0,0,0.35)] border border-[#e8e8e8]
              data-[open=false]:hidden data-[open=true]:block z-[70]">

    <div class="px-3 pt-2.5 pb-1.5 border-b border-[#e8e8e8]">
      <span class="text-[10px] font-bold uppercase tracking-wide text-[#a1a4aa]">Prototype · view as</span>
    </div>

    <% Persona.all.each do |p| %>
      <% active = p[:key] == current_persona_key %>
      <%= link_to persona_path(persona: p[:key]),
            class: "flex items-center gap-2.5 px-3 py-2.5 transition-colors #{active ? 'bg-[#f4f4f4]' : 'hover:bg-[#f8f8f8]'}" do %>

        <% if p[:logo] %>
          <img src="<%= p[:logo] %>" alt="" class="w-8 h-8 rounded-full object-cover shrink-0">
        <% else %>
          <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold shrink-0"
               style="background-color: <%= p[:avatar_bg] %>"><%= p[:initials] %></div>
        <% end %>

        <div class="flex flex-col min-w-0 flex-1">
          <span class="text-[#1f1f1f] text-xs font-bold leading-tight truncate"><%= p[:org] %></span>
          <span class="text-[#777] text-[10px] truncate"><%= p[:label] %></span>
        </div>

        <% if active %>
          <img src="/icon_checkmark.svg" alt="Current" class="w-3 h-3 shrink-0">
        <% end %>
      <% end %>
    <% end %>
  </div>

  <%# The identity block itself — click to open %>
  <button type="button"
          data-action="persona-switcher#toggle"
          class="no-min-h group w-full flex items-center gap-2 rounded-md p-0 text-left transition-colors hover:bg-[#2b2b2b] -mx-1 px-1 py-1"
          title="Switch persona (prototype)">

    <% if current_persona[:logo] %>
      <img src="<%= current_persona[:logo] %>" alt="" class="w-8 h-8 rounded-full object-cover shrink-0">
    <% else %>
      <div class="w-8 h-8 rounded-full flex items-center justify-center text-white text-xs font-bold shrink-0"
           style="background-color: <%= current_persona[:avatar_bg] %>"><%= current_persona[:initials] %></div>
    <% end %>

    <div class="flex flex-col min-w-0 flex-1">
      <span class="text-white text-xs font-bold leading-tight truncate"><%= current_persona[:org] %></span>
      <span class="text-white text-[10px] opacity-60 truncate"><%= current_persona[:email] %></span>
    </div>

    <%# Switch affordance — low-key until hover %>
    <svg class="w-3.5 h-3.5 shrink-0 text-white opacity-40 group-hover:opacity-90 transition-opacity"
         viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M4.5 3.5L2.5 5.5l2 2M2.5 5.5h7M9.5 10.5l2-2-2-2M11.5 8.5h-7"
            stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>
