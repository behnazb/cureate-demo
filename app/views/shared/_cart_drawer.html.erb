<%#
  CartDrawer — ported from components/CartDrawer.tsx.
  All cart state lives in cart_controller (singleton on <body>); this drawer reflects it.
  Three views (cart / confirmation / success) are layered; the controller flips data-view.
%>
<%
  # Seed data for the recently purchased strip (mirrors the React const).
  recently_purchased = [
    { vendor_id: "2betties",                  product_id: "16821" },
    { vendor_id: "ethiopian-delights",        product_id: "10616" },
    { vendor_id: "open-seas-coffee-roasters", product_id: "16523" },
    { vendor_id: "2betties",                  product_id: "16822" },
    { vendor_id: "ethiopian-delights",        product_id: "10617" },
    { vendor_id: "2betties",                  product_id: "16823" },
  ].map { |row|
    v = Vendor.find(row[:vendor_id])
    p = v&.products&.find { |x| x.id == row[:product_id] }
    next nil unless v && p
    { vendor: v, product: p }
  }.compact

  # Serialize all vendors + products + draft POs the drawer needs.
  # This lets the controller render vendor groups + product details without re-fetching.
  vendor_payload = Vendor.all.map do |v|
    {
      id: v.id, name: v.name,
      order_rules: {
        min_units:      v.order_rules&.dig(:min_units) || 0,
        units_per_case: v.order_rules&.dig(:units_per_case) || 1,
      },
      products: v.products.map { |p|
        next nil if p.shipping_fee?
        {
          id: p.id, name: p.name, image: p.image,
          wholesale_unit_price: p.wholesale_unit_price,
        }
      }.compact,
    }
  end

  draft_pos_payload = PurchaseOrder.all
    .select(&:draft?)
    .map { |po| { id: po.id, delivery_date_short: po.delivery_date_short } }
%>

<div data-controller="cart-drawer"
     data-cart-drawer-vendors-value="<%= vendor_payload.to_json %>"
     data-cart-drawer-draft-pos-value="<%= draft_pos_payload.to_json %>">

  <%# Backdrop — desktop only %>
  <div data-cart-drawer-target="backdrop"
       data-action="click->cart-drawer#close"
       data-transition="fade"
       class="hidden md:block fixed inset-0 bg-black/30 z-[70]"></div>

  <%# Drawer panel %>
  <aside data-cart-drawer-target="panel"
         data-transition="slide-in-right"
         class="fixed top-0 right-0 h-full w-full md:w-[520px] z-[80] overflow-hidden bg-[#f7f5ef] font-['Lato']">

    <%# ───── CART VIEW ───── %>
    <div data-cart-drawer-target="cartView" class="flex flex-col h-full relative">

      <%# Scrollable body %>
      <div class="flex-1 flex flex-col overflow-y-auto min-h-0">

        <%# Header %>
        <div class="sticky top-0 z-10 flex items-center justify-between px-4 shrink-0 border-b-2 relative h-[50px] border-[#e6e6e6] bg-[#f7f5ef]">
          <div class="flex items-center gap-2">
            <span class="font-bold text-[#1f1f1f] text-[14px]">Draft Purchase Order</span>
            <span data-cart-drawer-target="savedIndicator"
                  class="cart-saved-indicator hidden md:flex items-center gap-1 text-[11px] text-[#28ba93]">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2 6l3 3 5-5" stroke="#28ba93" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Draft saved
            </span>
          </div>
          <button data-action="click->cart-drawer#close" aria-label="Close cart"
                  class="no-min-h flex items-center justify-center w-6 h-6 hover:opacity-70 transition-opacity text-[#1f1f1f]">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <%# Staging mode — assign to PO (shown when no active PO + items) %>
        <div data-cart-drawer-target="stagingPanel"
             class="hidden border-b-2 shrink-0 px-4 py-3 border-[#e6e6e6] bg-[#fafafa]">
          <p class="text-[13px] font-bold text-[#1f1f1f] mb-1">Assign to a Purchase Order</p>
          <p class="text-[11px] mb-3 text-[#777]">Select an existing Draft PO or create a new one to save these items.</p>
          <div data-cart-drawer-target="draftPoList"></div>
          <button data-action="click->cart-drawer#createNewDraftPO"
                  class="w-full flex items-center justify-center gap-2 px-3 py-2.5 bg-[#28ba93] text-white rounded-xl hover:bg-[#22a882] transition-colors font-bold text-[13px] mt-2 no-min-h">
            + Create New Draft PO
          </button>
        </div>

        <%# Normal mode — PO selector %>
        <div data-cart-drawer-target="poSelector"
             class="border-b-2 shrink-0 border-[#e6e6e6]">
          <button data-action="click->cart-drawer#togglePOSelector"
                  class="flex items-center gap-2 w-full px-4 text-left h-[50px] no-min-h">
            <span class="font-bold text-[#1f1f1f] text-[14px]">Added to Draft PO</span>
            <span data-cart-drawer-target="poId" class="font-bold text-[#377b82] text-[14px]"></span>
            <span data-cart-drawer-target="poDelivery" class="ml-auto mr-1 text-[11px] text-[#777]"></span>
            <svg data-cart-drawer-target="poCaret" viewBox="0 0 7 4" fill="none" class="w-[7px] h-[4px] transition-transform duration-200">
              <path d="M1 1l2.5 2L6 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>

          <div data-cart-drawer-target="poDropdown" class="hidden overflow-hidden px-4 pb-4">
            <div class="flex items-center justify-between mb-3">
              <span class="text-[11px] font-bold text-[#1f1f1f]">Recent Open Purchase Orders</span>
              <button data-action="click->cart-drawer#showNewPOInput"
                      class="flex items-center gap-1.5 bg-[#beead8] hover:bg-[#a8dcc4] transition-colors rounded-full h-[26px] px-3 text-[11px] font-bold text-[#035257] no-min-h">
                Add New
                <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
                  <path d="M5.5 1v9M1 5.5h9" stroke="#035257" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
            </div>

            <%# New PO input (toggled) %>
            <div data-cart-drawer-target="newPOInputWrapper" class="hidden mb-3">
              <div class="flex items-center gap-2 py-1">
                <div class="w-4 h-4 rounded-[2px] border-2 border-dashed border-[#28ba93] shrink-0"></div>
                <div class="flex-1 relative">
                  <input data-cart-drawer-target="newPOInput"
                         data-action="keydown->cart-drawer#newPOKeyDown"
                         type="text" maxlength="30"
                         placeholder="e.g. 007-MARKET-00001"
                         class="w-full h-[26px] text-[11px] font-bold text-[#377b82] bg-transparent border-b-2 border-[#28ba93] outline-none placeholder-[#a1a4aa]">
                </div>
              </div>
              <p data-cart-drawer-target="newPOError" class="text-[10px] text-red-400 mt-1 ml-6 hidden"></p>
              <div class="flex items-center gap-2 mt-2 ml-6">
                <button data-action="click->cart-drawer#saveNewPO"
                        class="h-[24px] px-3 rounded-full text-[11px] font-bold bg-[#28ba93] text-white hover:bg-[#22a882] transition-all no-min-h">Save</button>
                <button data-action="click->cart-drawer#cancelNewPO"
                        class="h-[24px] px-3 rounded-full text-[11px] font-bold text-[#777] hover:text-[#444955] transition-colors no-min-h">Cancel</button>
              </div>
            </div>

            <%# PO list (rendered by controller) %>
            <div data-cart-drawer-target="poList" class="flex flex-col gap-0.5"></div>
          </div>
        </div>

        <%# Ordering window banner / editor %>
        <div class="border-b-2 shrink-0 border-[#e6e6e6]">
          <div data-cart-drawer-target="deliveryBanner" class="flex items-center gap-2 px-4 py-2.5">
            <span class="text-[12px] text-[#777]">Ordering for:</span>
            <span data-cart-drawer-target="weekLabel" class="text-[12px] font-bold text-[#1f1f1f]"></span>
            <span data-cart-drawer-target="repeatLabel" class="text-[11px] font-bold text-[#28ba93] hidden"></span>
            <button data-action="click->cart-drawer#showDeliveryEditor"
                    class="ml-1 flex items-center justify-center hover:opacity-70 transition-opacity text-[#28ba93] no-min-h">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M7.5 2l2.5 2.5L4 10.5H1.5V8L7.5 2z" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <div data-cart-drawer-target="deliveryEditor" class="hidden px-4 py-3">
            <div class="flex items-center gap-3 mb-2">
              <span class="text-[12px] text-[#777] w-[100px] shrink-0">Delivery week</span>
              <select data-cart-drawer-target="weekSelect"
                      data-action="change->cart-drawer#setWeek"
                      class="flex-1 text-[12px] border border-[#e8e8e8] rounded-lg px-3 h-[30px] bg-white text-[#444955] outline-none cursor-pointer hover:border-[#28ba93] transition-colors"></select>
            </div>
            <div class="flex items-center gap-3 mb-3">
              <span class="text-[12px] text-[#777] w-[100px] shrink-0">Repeat</span>
              <select data-cart-drawer-target="repeatSelect"
                      data-action="change->cart-drawer#setRepeat"
                      class="flex-1 text-[12px] border border-[#e8e8e8] rounded-lg px-3 h-[30px] bg-white text-[#444955] outline-none cursor-pointer hover:border-[#28ba93] transition-colors">
                <option value="none">Does not repeat</option>
                <option value="weekly">Weekly every Wednesday</option>
                <option value="biweekly">Bi-weekly (every 2 weeks)</option>
                <option value="monthly">Monthly (first Wednesday)</option>
                <option value="custom">Custom...</option>
              </select>
            </div>
            <div class="flex justify-end">
              <button data-action="click->cart-drawer#hideDeliveryEditor"
                      class="text-[12px] font-bold text-white bg-[#28ba93] rounded-full px-4 h-[28px] hover:bg-[#22a882] transition-colors no-min-h">Done</button>
            </div>
          </div>
        </div>

        <%# Cart items %>
        <div class="flex flex-col flex-1">
          <div data-cart-drawer-target="emptyState" class="px-4 flex flex-col items-center justify-center py-16 text-center">
            <p class="font-bold text-[#444955] text-[16px]">Your PO is empty</p>
            <p class="mt-1 text-[#777] text-[13px]">Add products to get started</p>
          </div>

          <div data-cart-drawer-target="vendorGroups" class="hidden px-4 pt-4 pb-4 flex-col gap-4"></div>

          <%# PO subtotal %>
          <div data-cart-drawer-target="subtotalBlock" class="hidden">
            <div class="w-full h-[2px] bg-[#e6e6e6] shrink-0"></div>
            <div class="flex items-center justify-between px-4 py-3 shrink-0">
              <span class="font-bold text-[#1f1f1f] text-[14px]">Purchase Order Subtotal</span>
              <span data-cart-drawer-target="subtotal" class="font-bold text-[#1f1f1f] text-[14px]">$0.00</span>
            </div>
          </div>

          <%# Recently purchased %>
          <div class="w-full h-[2px] bg-[#e6e6e6] shrink-0"></div>
          <div class="px-4 pt-4 pb-4">
            <div class="flex items-center justify-between py-3">
              <span class="font-bold text-[#1f1f1f] text-[11px]">Recently Purchased</span>
              <button class="flex items-center gap-1 font-bold text-[#035257] text-[11px] no-min-h">
                View all
                <svg viewBox="0 0 7 11" fill="none" class="w-[7px] h-[11px]">
                  <path d="M1 1l4.5 4.5L1 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
            </div>
            <div class="flex items-stretch gap-2 overflow-x-auto pb-4 scrollbar-hide">
              <% recently_purchased.each do |rp| %>
                <div class="shrink-0 w-[150px] flex flex-col">
                  <%= render "shared/product_card", product: rp[:product], vendor: rp[:vendor] %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# Discard prompt overlay %>
      <div data-cart-drawer-target="discardPrompt"
           data-transition="fade"
           class="absolute inset-0 z-20 flex flex-col items-center justify-center px-8"
           style="background-color: rgba(247,245,239,0.97)">
        <div class="bg-white rounded-2xl p-6 w-full max-w-[340px] flex flex-col items-center gap-4 text-center shadow-[0_4px_24px_rgba(0,0,0,0.12)]">
          <div class="w-10 h-10 rounded-full bg-[#fff3cd] flex items-center justify-center shrink-0">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 6v5M10 14h.01" stroke="#b45309" stroke-width="1.8" stroke-linecap="round"/>
              <circle cx="10" cy="10" r="8.5" stroke="#b45309" stroke-width="1.5"/>
            </svg>
          </div>
          <div>
            <p class="text-[15px] font-bold text-[#1f1f1f] mb-1">Discard staged items?</p>
            <p class="text-[13px] text-[#777] leading-snug">
              You have <span data-cart-drawer-target="discardCount">0</span> items that haven't been assigned to a Purchase Order. They'll be lost if you close.
            </p>
          </div>
          <div class="flex flex-col gap-2 w-full">
            <button data-action="click->cart-drawer#hideDiscardPrompt"
                    class="w-full h-[42px] rounded-full font-bold text-[14px] bg-[#28ba93] text-white hover:bg-[#22a882] transition-colors no-min-h">Keep shopping</button>
            <button data-action="click->cart-drawer#confirmDiscard"
                    class="w-full h-[42px] rounded-full font-bold text-[14px] border border-[#e6e6e6] text-[#777] hover:bg-[#f7f5ef] transition-colors no-min-h">Discard items</button>
          </div>
        </div>
      </div>

      <%# Sticky bottom CTA %>
      <div class="shrink-0">
        <div class="flex items-center justify-between px-4 bg-[#beead8] h-[50px]">
          <div class="flex items-center gap-3" data-cart-drawer-target="minStatus">
            <span class="text-[#1f1f1f] text-[14px]">Add more items to meet min order quantity</span>
          </div>
          <button data-action="click->cart-drawer#close" aria-label="Close cart"
                  class="flex items-center justify-center w-6 h-6 hover:opacity-70 transition-opacity text-[#1f1f1f] no-min-h">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <div class="h-[4px] w-full bg-[#e6e6e6]">
          <div data-cart-drawer-target="progressBar" class="h-full bg-[#035257] transition-all duration-400 ease-out" style="width: 0%"></div>
        </div>

        <div class="flex items-center gap-2 px-4 h-[65px] bg-[#f7f5ef]">
          <button data-action="click->cart-drawer#saveDraft"
                  data-cart-drawer-target="saveButton"
                  class="no-min-h basis-1/3 rounded-full font-bold transition-all duration-200 flex items-center justify-center active:scale-[0.96]"
                  style="height: 52px; font-size: 14px; background-color: white; color: #28ba93;">Save Draft</button>
          <button data-action="click->cart-drawer#continueToPO"
                  data-cart-drawer-target="continueButton"
                  disabled
                  class="no-min-h basis-2/3 flex-1 rounded-full font-bold transition-all disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98]"
                  style="height: 52px; background-color: #e6e6e6; color: #a1a4aa; font-size: 18px;">Continue to PO</button>
        </div>
      </div>
    </div>

    <%# ───── CONFIRMATION VIEW ───── %>
    <div data-cart-drawer-target="confirmationView" class="hidden flex-col h-full relative">
      <div class="flex items-center justify-between h-[50px] px-4 border-b-2 border-[#e6e6e6] shrink-0 bg-[#f7f5ef]">
        <div class="flex items-center gap-3">
          <button data-action="click->cart-drawer#backToCart"
                  class="text-[11px] font-bold text-[#377b82] hover:text-[#035257] transition-colors flex items-center gap-1 no-min-h">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M8 1L3 6l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Edit Order
          </button>
          <div class="w-px h-4 bg-[#e6e6e6]"></div>
          <span class="text-[14px] font-bold text-[#1f1f1f]">Order Confirmation</span>
        </div>
        <button data-action="click->cart-drawer#close" class="w-6 h-6 flex items-center justify-center text-[#777] hover:text-[#1f1f1f] transition-colors no-min-h">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
      <div class="flex items-center gap-2 h-[50px] px-4 border-b-2 border-[#e6e6e6] shrink-0 bg-[#f7f5ef]">
        <span class="text-[14px] font-bold text-[#1f1f1f]">Purchase Order</span>
        <div class="flex items-center gap-1.5 bg-[#beead8] rounded-full px-3 h-[26px]">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
            <path d="M1 5.5l2.5 2.5 5.5-6" stroke="#035257" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span data-cart-drawer-target="confirmationPOId" class="text-[11px] font-bold text-[#035257]"></span>
        </div>
      </div>
      <div data-cart-drawer-target="confirmationBody" class="flex-1 overflow-y-auto py-4 flex flex-col gap-4"></div>
      <div class="absolute bottom-0 left-0 right-0 border-t-2 border-[#e6e6e6] px-4 py-4 flex flex-col gap-3 bg-[#f7f5ef]">
        <button data-action="click->cart-drawer#submitPO"
                class="w-full h-[49px] rounded-full bg-[#28ba93] text-white text-[16px] font-bold flex items-center justify-center gap-2 hover:bg-[#22a882] transition-colors no-min-h hover:scale-[1.01] active:scale-[0.98]">
          Submit PO for Review
        </button>
      </div>
    </div>

    <%# ───── SUCCESS VIEW ───── %>
    <div data-cart-drawer-target="successView" class="hidden flex-col h-full items-center justify-center px-8 text-center relative bg-[#f7f5ef]">
      <button data-action="click->cart-drawer#close"
              class="absolute top-4 right-4 w-6 h-6 flex items-center justify-center text-[#777] hover:text-[#1f1f1f] transition-colors no-min-h">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
      <div class="relative mb-8">
        <div class="w-24 h-24 rounded-full bg-[#28ba93] flex items-center justify-center relative z-10">
          <svg width="40" height="32" viewBox="0 0 40 32" fill="none">
            <path d="M3 16l11 11L37 3" stroke="white" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      </div>
      <div class="flex flex-col items-center gap-3 mb-8">
        <h2 class="text-[24px] font-black text-[#1f1f1f]">PO Submitted!</h2>
        <p class="text-[14px] text-[#777] leading-relaxed max-w-[280px]">
          Your purchase order <span data-cart-drawer-target="successPOId" class="font-bold text-[#035257]"></span> has been submitted for review. Vendors will be notified shortly.
        </p>
        <div data-cart-drawer-target="successVendors" class="flex flex-col gap-2 w-full mt-2"></div>
      </div>
      <div class="flex flex-col items-center gap-3 w-full">
        <div class="w-full h-1 bg-[#e6e6e6] rounded-full overflow-hidden">
          <div data-cart-drawer-target="successProgress" class="h-full bg-[#28ba93] rounded-full" style="width: 100%; transition: width 8000ms linear;"></div>
        </div>
        <p class="text-[11px] text-[#a1a4aa]">Closing in <span data-cart-drawer-target="countdown">8</span>s</p>
        <button data-action="click->cart-drawer#close"
                class="text-[13px] font-bold text-[#035257] hover:underline transition-colors no-min-h">
          Close and continue shopping
        </button>
      </div>
    </div>
  </aside>
</div>
