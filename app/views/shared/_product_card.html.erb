<%#
  Locals: product, vendor (only id + name needed)
  Quantity badge / stepper handled inline (mirrors ProductCard.tsx layout).
%>
<% return if product.shipping_fee? || product.image.blank? %>
<% qty_class_id     = "product-card-#{vendor.id}-#{product.id}" %>
<%# Width + add-button placement are overridable so the same card works in the full
    gallery (200px) and the compact cart "Recently Purchased" strip. %>
<% frame_class      = local_assigns.fetch(:frame_class, "w-full md:w-[200px] md:shrink-0 hover:scale-[1.03] transition-transform") %>
<% add_button_class = local_assigns.fetch(:add_button_class, "absolute bottom-2 right-2") %>

<%= link_to vendor_product_path(vendor.id, product.id),
    class: "group product-card no-min-h block h-full #{qty_class_id}",
    data: { vendor_id: vendor.id, product_id: product.id, controller: "product-card" } do %>
  <div class="flex flex-col rounded-lg bg-white shadow-sm cursor-pointer <%= frame_class %> border border-[#e8e8e8]"
       data-product-card-target="frame">
    <div class="relative shrink-0 bg-[#f7f5ef] flex items-center justify-center p-2 overflow-hidden rounded-t-lg aspect-square md:aspect-auto md:h-[135px]">
      <img src="<%= product.image %>" alt="<%= product.name %>" class="h-full w-full object-contain mix-blend-multiply">

      <%# Add button — replaced by stepper when qty > 0 (driven by add_to_cart controller) %>
      <div class="<%= add_button_class %>">
        <%= render "shared/add_to_cart_button", vendor_id: vendor.id, product_id: product.id %>
      </div>
    </div>

    <div class="flex-1 flex flex-col overflow-hidden p-[10px] gap-[8px]">
      <p class="font-bold text-[#377b82] text-[14px]"><%= vendor.name %></p>
      <p class="font-bold leading-tight text-[#444955] text-[12px] line-clamp-2 min-h-[1.5rem]"><%= product.name %></p>

      <%# Minimum orderable quantity + the price of that orderable unit, mirroring the
          product detail page. Case-ordered products (case_minimum set) show cases and the
          case price; unit-ordered products show units and the unit price. %>
      <div class="mt-auto flex flex-col gap-[2px]">
        <% label = product.unit_label || "unit" %>
        <% item_label = product.item_label || "unit" %>
        <% if product.case_minimum %>
          <% cm = product.case_minimum %>
          <p class="text-[13px]">
            <span class="font-bold text-[#444955]"><%= cm %> <%= cm == 1 ? "Case" : "Cases" %></span>
            <% if product.wholesale_case_price %>
              <span class="text-[#777]">· $<%= sprintf("%.2f", product.wholesale_case_price) %> / Case</span>
            <% end %>
          </p>
          <% if product.wholesale_case_price && item_label != "case" && product.units_per_case.to_i > 0 %>
            <% item_price = (product.units_per_item || 1).to_f / product.units_per_case * product.wholesale_case_price %>
            <p class="text-[#999] text-[12px]">$<%= sprintf("%.2f", item_price) %> / <%= item_label %></p>
          <% end %>
        <% else %>
          <% um = product.unit_minimum || 1 %>
          <p class="text-[13px]">
            <span class="font-bold text-[#444955]"><%= um %> <%= um == 1 ? "Unit" : "Units" %></span>
            <span class="text-[#777]">· $<%= sprintf("%.2f", product.wholesale_unit_price) %> / <%= label %></span>
          </p>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
