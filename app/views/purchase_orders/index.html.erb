<% content_for :title, "Purchase Orders — Cureate Connect" %>
<% primary_tabs  = PurchaseOrder.primary_tabs %>
<% overflow_tabs = PurchaseOrder.overflow_tabs %>

<div data-controller="purchase-orders-page"
     data-purchase-orders-page-active-tab-value="<%= @active_tab %>"
     class="flex flex-1 min-h-0 bg-white font-['Lato']">

  <%= render "shared/sidebar" %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">

    <%# Desktop header %>
    <div class="hidden md:flex items-center justify-between px-9 py-4 border-b border-[#e8e8e8] bg-white shrink-0">
      <div class="flex items-center gap-5">
        <h1 class="text-[20px] font-bold text-[#1f1f1f] whitespace-nowrap">Purchase Orders</h1>
        <%= form_with(url: purchase_orders_path, method: :get, class: "flex items-center gap-2 h-[38px] bg-white border rounded-full px-[10px] w-[300px] border-[#a1a4aa] hover:border-[#777] transition-all duration-200", local: true) do |f| %>
          <%= hidden_field_tag :tab, @active_tab %>
          <img src="/icons/icon_search.svg" alt="" class="w-[14px] h-[14px] shrink-0 opacity-60">
          <%= text_field_tag :q, @search,
                placeholder: "Search by number, name or date",
                class: "flex-1 bg-transparent text-[13px] text-[#444955] placeholder-[#737780] outline-none" %>
        <% end %>
      </div>
      <div class="flex items-center gap-3">
        <%= link_to "+ New Purchase Order", products_path,
            class: "no-min-h bg-[#28ba93] text-white text-[13px] font-bold rounded-full px-4 h-[38px] flex items-center gap-1 hover:bg-[#22a882] transition-colors" %>
      </div>
    </div>

    <%# Desktop tabs %>
    <div class="hidden md:flex items-center gap-1 px-9 py-3 border-b border-[#e8e8e8] bg-white shrink-0 overflow-x-auto scrollbar-none">
      <% if @view == "table" %>
        <div class="flex items-center gap-1 shrink-0">
          <% primary_tabs.each do |tab| %>
            <% active = tab[:value] == @active_tab %>
            <%= link_to tab[:label],
                purchase_orders_path(tab: tab[:value]),
                class: "no-min-h px-4 h-[32px] rounded-full text-[12px] font-bold whitespace-nowrap flex items-center transition-colors #{active ? 'bg-[#1f1f1f] text-white' : 'text-[#777] hover:text-[#1f1f1f] hover:bg-[#f0f0f0]'}" %>
          <% end %>
        </div>

        <%# Rarely-used statuses — demoted behind a divider (T05) %>
        <div class="flex items-center gap-1 shrink-0 ml-2 pl-3 border-l border-[#e8e8e8]">
          <% overflow_tabs.each do |tab| %>
            <% active = tab[:value] == @active_tab %>
            <%= link_to tab[:label],
                purchase_orders_path(tab: tab[:value]),
                class: "no-min-h px-3 h-[32px] rounded-full text-[12px] font-bold whitespace-nowrap flex items-center transition-colors #{active ? 'bg-[#1f1f1f] text-white' : 'text-[#a1a4aa] hover:text-[#1f1f1f] hover:bg-[#f0f0f0]'}" %>
          <% end %>
        </div>
      <% end %>

      <%# View toggle (table / board) + date-range filter %>
      <div class="ml-auto shrink-0 flex items-center gap-3">
        <div class="flex items-center overflow-hidden" style="border:1px solid #a1a4aa; border-radius:9999px; height:32px;">
          <%= link_to purchase_orders_path(view: "table", tab: @active_tab, q: @search.presence),
              class: "no-min-h flex items-center justify-center transition-colors #{@view == 'table' ? 'text-white' : 'text-[#777] hover:bg-[#f0f0f0]'}",
              style: "width:40px; height:32px;#{@view == 'table' ? ' background-color:#1f1f1f;' : ''}", title: "Table view" do %>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 3h12M1 7h12M1 11h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <% end %>
          <%= link_to purchase_orders_path(view: "board", q: @search.presence),
              class: "no-min-h flex items-center justify-center transition-colors #{@view == 'board' ? 'text-white' : 'text-[#777] hover:bg-[#f0f0f0]'}",
              style: "width:40px; height:32px; border-left:1px solid #a1a4aa;#{@view == 'board' ? ' background-color:#1f1f1f;' : ''}", title: "Board view" do %>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><rect x="1" y="1.5" width="3.4" height="11" rx="1" stroke="currentColor" stroke-width="1.3"/><rect x="5.3" y="1.5" width="3.4" height="7.5" rx="1" stroke="currentColor" stroke-width="1.3"/><rect x="9.6" y="1.5" width="3.4" height="9.5" rx="1" stroke="currentColor" stroke-width="1.3"/></svg>
          <% end %>
        </div>
        <div class="relative">
          <svg class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 w-3 h-[11px] text-[#777]" viewBox="0 0 12 11" fill="none">
            <path d="M1 1.5h10M3 5.5h6M5 9.5h2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <select class="h-[32px] rounded-full border border-[#a1a4aa] pl-8 pr-3 text-[12px] text-[#444955] bg-white outline-none hover:border-[#777] transition-colors cursor-pointer appearance-none"
                  style="background-image: url(\"data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%23777' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E\"); background-repeat: no-repeat; background-position: right 4px center;">
            <option value="7">Last 7 days</option>
            <option value="30" selected>Last 30 days</option>
            <option value="90">Last 90 days</option>
            <option value="all">All time</option>
          </select>
        </div>
      </div>
    </div>

    <%# Mobile segmented control — primary statuses scroll horizontally; rarely-used
        (Invoiced / Cancelled) live in the "More" sheet (T05). %>
    <div class="md:hidden flex items-center gap-1.5 px-4 py-3 border-b border-[#e8e8e8] bg-white shrink-0">
      <div class="flex items-center gap-1.5 overflow-x-auto scrollbar-none flex-1 min-w-0">
        <% primary_tabs.each do |tab| %>
          <% active = tab[:value] == @active_tab %>
          <%= link_to tab[:label],
              purchase_orders_path(tab: tab[:value]),
              class: "no-min-h h-[34px] px-3 text-[12px] font-bold rounded-full whitespace-nowrap flex items-center shrink-0 transition-colors #{active ? 'bg-[#1f1f1f] text-white' : 'text-[#777]'}" %>
        <% end %>
      </div>
      <% active_overflow = overflow_tabs.find { |t| t[:value] == @active_tab } %>
      <button data-action="click->purchase-orders-page#openMoreSheet"
              class="no-min-h h-[34px] px-3 text-[12px] font-bold rounded-full whitespace-nowrap flex items-center gap-1 shrink-0 transition-colors <%= active_overflow ? 'bg-[#1f1f1f] text-white' : 'text-[#777] border border-[#e0e0e0]' %>">
        <%= active_overflow ? active_overflow[:label] : "More" %>
        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
          <path d="M2 3.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <%# Mobile More sheet %>
    <div data-purchase-orders-page-target="moreBackdrop"
         data-action="click->purchase-orders-page#closeMoreSheet"
         data-transition="fade"
         class="md:hidden fixed inset-0 bg-black/40 z-40"></div>
    <div data-purchase-orders-page-target="moreSheet"
         data-transition="slide-in-bottom"
         class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white rounded-t-2xl shadow-[0_-4px_24px_rgba(0,0,0,0.15)]">
      <div class="flex justify-center py-3"><div class="w-10 h-1 bg-[#e0e0e0] rounded-full"></div></div>
      <div class="px-5 pb-2"><h3 class="text-[14px] font-bold text-[#1f1f1f]">Filter by status</h3></div>
      <div class="py-2">
        <% overflow_tabs.each do |tab| %>
          <% active = tab[:value] == @active_tab %>
          <%= link_to purchase_orders_path(tab: tab[:value]),
              data: { action: "click->purchase-orders-page#closeMoreSheet" },
              class: "w-full flex items-center justify-between px-5 py-3.5 text-[14px] font-bold no-min-h #{active ? 'text-[#28ba93]' : 'text-[#1f1f1f]'}" do %>
            <span><%= tab[:label] %></span>
            <% if active %>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M3 8l3 3 7-7" stroke="#28ba93" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            <% end %>
          <% end %>
        <% end %>
      </div>
      <div class="h-6"></div>
    </div>

    <%# Mobile card list %>
    <div class="block md:hidden flex-1 overflow-y-auto py-3">
      <% @purchase_orders.each do |po| %>
        <%= link_to purchase_order_path(po.id),
            class: "block mx-4 mb-3 bg-white border border-[#e8e8e8] rounded-xl p-4 active:bg-[#f7f5ef] transition-colors no-min-h" do %>
          <div class="flex items-start justify-between mb-2">
            <span class="text-[14px] font-bold text-[#28ba93]"><%= po.id %></span>
            <%= render "shared/po_status_badge", status: po.status, label: po_line_status_label(po) %>
          </div>
          <div class="flex items-center justify-between">
            <div>
              <p class="text-[11px] text-[#777]"><%= delivery_week_label(po.delivery_date) %></p>
              <% if po.date_range %>
                <p class="text-[11px] text-[#777] mt-0.5"><%= po.date_range[:start] %> – <%= po.date_range[:end] %></p>
              <% end %>
            </div>
            <span class="text-[16px] font-black text-[#1f1f1f]">$<%= format("%.2f", po.total) %></span>
          </div>
        <% end %>
      <% end %>
      <% if @purchase_orders.empty? %>
        <div class="px-4 py-16 text-center">
          <p class="text-[14px] font-bold text-[#444955]">No purchase orders found</p>
          <p class="text-[12px] text-[#777] mt-1">
            <%= @search.present? ? "Try adjusting your search" : "No #{@tab_config[:label].downcase} purchase orders" %>
          </p>
        </div>
      <% end %>
    </div>

    <%# Desktop board (kanban) — one column per status %>
    <% if @view == "board" %>
      <div class="hidden md:flex flex-1 overflow-x-auto gap-4 px-9 py-6 bg-[#f7f5ef] items-start">
        <% @board_columns.each do |col| %>
          <div class="shrink-0 w-[270px] flex flex-col">
            <div class="flex items-center gap-2 px-1 mb-3">
              <span class="text-[12px] font-bold text-[#444955]"><%= col[:label] %></span>
              <span class="text-[11px] font-bold text-[#777] bg-white border border-[#e8e8e8] rounded-full px-2 py-0.5"><%= col[:pos].size %></span>
            </div>
            <div class="flex flex-col gap-3">
              <% col[:pos].each do |po| %>
                <%= link_to purchase_order_path(po.id),
                    class: "block bg-white border border-[#e8e8e8] rounded-xl p-3.5 hover:shadow-md hover:border-[#d0d0d0] transition-all no-min-h" do %>
                  <p class="text-[13px] font-bold text-[#28ba93] mb-1.5"><%= po.id %></p>
                  <p class="text-[11px] text-[#777]"><%= delivery_week_label(po.delivery_date) %></p>
                  <p class="text-[14px] font-bold text-[#1f1f1f] mt-2">$<%= format("%.2f", po.total) %></p>
                <% end %>
              <% end %>
              <% if col[:pos].empty? %>
                <div class="text-[11px] text-[#a1a4aa] py-6 text-center border border-dashed border-[#e0e0e0] rounded-xl">No orders</div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
    <%# Desktop table %>
    <div class="hidden md:block flex-1 overflow-auto">
      <table class="w-full border-collapse">
        <thead class="sticky top-0 bg-[#fafafa] z-10">
          <tr class="border-b border-[#e8e8e8]">
            <% ["PO Number", "Date Range", "Delivery Week", "Total Amount", "Status", ""].each_with_index do |h, i| %>
              <th class="text-left <%= i == 0 ? 'px-9' : 'px-3' %> py-3 text-[12px] font-bold text-[#777] uppercase tracking-wide <%= 'w-[60px]' if h.empty? %>"><%= h %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @purchase_orders.each do |po| %>
            <tr data-controller="row-link"
                data-row-link-url-value="<%= purchase_order_path(po.id) %>"
                data-action="click->row-link#go"
                class="border-b border-[#e8e8e8] hover:bg-[#f7f5ef] cursor-pointer transition-colors group">
              <td class="px-9 py-4">
                <span class="text-[13px] font-bold text-[#28ba93] group-hover:text-[#035257] transition-colors"><%= po.id %></span>
              </td>
              <td class="px-3 py-4 text-[13px] text-[#777]">
                <%= po.date_range ? "#{po.date_range[:start]} – #{po.date_range[:end]}" : "—" %>
              </td>
              <td class="px-3 py-4 text-[13px] text-[#777]"><%= delivery_week_label(po.delivery_date) %></td>
              <td class="px-3 py-4 text-[13px] font-bold text-[#1f1f1f]">$<%= format("%.2f", po.total) %></td>
              <td class="px-3 py-4"><%= render "shared/po_status_badge", status: po.status, label: po_line_status_label(po) %></td>
              <td class="px-3 py-4 text-right">
                <%= render "shared/po_dropdown_menu", items: [
                  { label: "Add more to PO",   icon: "add",       action: "po:add-more",   detail: { id: po.id } },
                  { label: "Duplicate PO",     icon: "duplicate", action: "po:duplicate",  detail: { id: po.id } },
                  { label: "Request support",  icon: "support",   action: "po:support",    detail: { id: po.id } },
                  *( %w[Delivered Cancelled].include?(po.status) ? [] : [{ label: "Cancel PO", icon: "cancel", action: "po:cancel", danger: true, detail: { id: po.id } }] ),
                ] %>
              </td>
            </tr>
          <% end %>
          <% if @purchase_orders.empty? %>
            <tr>
              <td colspan="6" class="px-9 py-16 text-center">
                <p class="text-[14px] font-bold text-[#444955]">No purchase orders found</p>
                <p class="text-[12px] text-[#777] mt-1">
                  <%= @search.present? ? "Try adjusting your search" : "No #{@tab_config[:label].downcase} purchase orders" %>
                </p>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% end %>

  </div>
</div>
