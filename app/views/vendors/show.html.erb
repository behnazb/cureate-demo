<% content_for :title, "#{@vendor.name} — Cureate Connect" %>
<% businesss_details = [
  { label: "Business Type",          value: @vendor.business_type },
  { label: "Revenue",                value: @vendor.revenue },
  { label: "Employees",              value: @vendor.employees },
  { label: "Insurance",              value: "General Liability, Workers' Comp" },
  { label: "Health Dept. Clearance", value: "Yes" },
  { label: "Certifications",         value: @vendor.certifications.any? ? @vendor.certifications.join(", ") : "—" },
] %>
<% businesss_details << { label: "Categories", value: @vendor.categories.join(", ") } if @vendor.categories&.any? %>
<% businesss_details << { label: "Goal",       value: @vendor.goals.first } if @vendor.goals&.any? %>

<% logistics = [
  { label: "Delivery & Shipping", value: "Shipping available nationwide" },
  { label: "Delivery Schedule",   value: @vendor.delivery_schedule },
  { label: "Min. Order Qty",      value: @vendor.min_order_quantity },
  { label: "Production",          value: "Baltimore, MD" },
  { label: "Seasonal Offerings",  value: "Seasonal offerings available" },
  { label: "Growth Goals",        value: "Certified" },
] %>

<div class="flex h-screen overflow-hidden font-['Lato']">
  <%= render "shared/sidebar" %>

  <div class="flex-1 overflow-y-auto bg-white">

    <%# Breadcrumb — sticky so the cart stays visible while scrolling to the
        product gallery at the bottom (T12) %>
    <div class="sticky top-0 z-20 bg-white border-b border-[#e8e8e8]">
      <div class="px-4 md:px-9 py-3 flex items-center justify-between gap-3">
        <nav aria-label="Breadcrumb" class="min-w-0">
          <ol class="flex items-center gap-2 text-[13px]">
            <li>
              <%= link_to vendors_path, class: "text-[#28ba93] font-bold hover:underline flex items-center gap-1 no-min-h" do %>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M7.5 2.5L4 6l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                Vendors
              <% end %>
            </li>
            <li class="text-[#ccc]">/</li>
            <li class="text-[#1f1f1f] font-bold truncate"><%= @vendor.name %></li>
          </ol>
        </nav>
        <%= render "shared/view_cart_button" %>
      </div>
    </div>

    <main class="px-4 md:px-9">

      <%# Hero %>
      <div class="pt-6 pb-6 border-b border-[#e8e8e8]">
        <div class="flex items-start gap-4 md:gap-8">
          <div class="w-[80px] h-[80px] md:w-[120px] md:h-[120px] rounded-xl border border-[#e8e8e8] overflow-hidden bg-white flex items-center justify-center shrink-0">
            <img src="<%= @vendor.logo %>" alt="<%= @vendor.name %>" class="w-full h-full object-contain p-2">
          </div>
          <div class="flex-1 min-w-0 pt-1">
            <p class="text-[11px] md:text-[12px] font-bold text-[#28ba93] uppercase tracking-[0.08em] mb-1"><%= @vendor.location %></p>
            <h1 class="text-[26px] md:text-[34px] font-black text-[#1f1f1f] uppercase tracking-tight leading-tight mb-1"><%= @vendor.name %></h1>
            <% if @vendor.owned %>
              <p class="text-[13px] md:text-[14px] text-[#666] italic mb-3"><%= @vendor.owned %></p>
            <% end %>
            <div class="flex gap-2">
              <% [
                ["Instagram", "<rect x='2' y='2' width='12' height='12' rx='3' stroke='currentColor' stroke-width='1.3'/><circle cx='8' cy='8' r='2.5' stroke='currentColor' stroke-width='1.3'/><circle cx='11.2' cy='4.8' r='0.6' fill='currentColor'/>"],
                ["Twitter",   "<path d='M2 2.5h4l2.5 3.5L11 2.5h1.5L9 7l4.5 6.5H9.5L7 10 4.5 13.5H3L6.5 8.5 2 2.5z' stroke='currentColor' stroke-width='1.1' stroke-linejoin='round' stroke-linecap='round'/>"],
                ["Facebook",  "<path d='M9 2.5H10.5V1H9C7.34 1 6 2.34 6 4v1.5H4.5V7H6v7h1.5V7H9l.5-1.5H7.5V4c0-.83.67-1.5 1.5-1.5z' stroke='currentColor' stroke-width='1.1' stroke-linejoin='round'/>"],
              ].each do |label, svg| %>
                <a href="#" aria-label="<%= label %>" class="no-min-h w-9 h-9 rounded-full bg-[#f7f5ef] flex items-center justify-center text-[#777] hover:bg-[#e8e8e8] transition-colors">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><%= svg.html_safe %></svg>
                </a>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <%# The Business %>
      <section class="py-5 border-b border-[#e8e8e8]">
        <h2 class="text-[18px] font-bold text-[#1f1f1f] mb-3">The Business</h2>
        <p class="text-[15px] leading-[1.6] text-[#444955]"><%= @vendor.about %></p>
      </section>

      <%# Contact & Location %>
      <section class="py-5 border-b border-[#e8e8e8]">
        <h3 class="text-[13px] font-bold text-[#666] uppercase tracking-wide mb-4">Contact & Location</h3>
        <div class="flex items-start gap-3 mb-3">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-[#999] shrink-0 block" style="margin-top: 2px">
            <path d="M8 1.5a5 5 0 00-5 5c0 3.5 5 8 5 8s5-4.5 5-8a5 5 0 00-5-5z" stroke="currentColor" stroke-width="1.25"/>
            <circle cx="8" cy="6.5" r="1.5" stroke="currentColor" stroke-width="1.25"/>
          </svg>
          <p class="text-[14px] text-[#1f1f1f] leading-snug"><%= @vendor.address %></p>
        </div>
        <div class="flex items-center gap-3">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-[#999] shrink-0 block">
            <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.25"/>
            <path d="M2 8h12M8 2c2 2 2 10 0 12M8 2c-2 2-2 10 0 12" stroke="currentColor" stroke-width="1.25"/>
          </svg>
          <a href="<%= full_url(@vendor.website) %>" target="_blank" rel="noopener noreferrer"
             class="text-[14px] text-[#28ba93] font-bold" style="line-height: 16px">
            <%= display_url(@vendor.website) %>
          </a>
        </div>
      </section>

      <% if @vendor.story.present? %>
        <section class="py-5 border-b border-[#e8e8e8]">
          <h2 class="text-[18px] font-bold text-[#1f1f1f] mb-3">Our Story</h2>
          <p class="text-[15px] leading-[1.6] text-[#444955]"><%= @vendor.story %></p>
        </section>
      <% end %>

      <%# Business Details %>
      <section class="py-5 border-b border-[#e8e8e8]">
        <h3 class="text-[13px] font-bold text-[#666] uppercase tracking-wide mb-4">Business Details</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
          <% businesss_details.each do |row| %>
            <% next if row[:value].blank? %>
            <div>
              <p class="text-[11px] font-bold text-[#999] uppercase tracking-wide mb-1"><%= row[:label] %></p>
              <p class="text-[14px] text-[#1f1f1f]"><%= row[:value] %></p>
            </div>
          <% end %>
        </div>
      </section>

      <%# Vendor Resources %>
      <section class="py-5 border-b border-[#e8e8e8]">
        <h2 class="text-[18px] font-bold text-[#1f1f1f] mb-2">Vendor Resources</h2>
        <p class="text-[14px] text-[#666] leading-relaxed mb-4">Download promotional materials to feature this vendor in your marketplace or dining communications.</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
          <% ["Small (5x3)", "Medium (4x6)", "Large (8.5x11)", "Digital Flyer", "Monitor Graphic"].each do |asset| %>
            <a href="#" class="flex items-center gap-2 p-3 bg-white border border-[#e8e8e8] rounded-lg hover:bg-[#f7f5ef] transition-colors no-min-h">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="shrink-0 text-[#28ba93]">
                <path d="M8 2v9m0 0l-3-3m3 3l3-3M3 13h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span class="text-[13px] font-bold text-[#1f1f1f] truncate"><%= asset %></span>
            </a>
          <% end %>
        </div>
      </section>

      <%# Logistics %>
      <section class="py-5 border-b border-[#e8e8e8]">
        <h2 class="text-[18px] font-bold text-[#1f1f1f] mb-4">Logistics & Fulfillment</h2>
        <% logistics.each_with_index do |row, i| %>
          <div class="flex justify-between items-start gap-4 py-3 <%= 'border-b border-[#f0f0f0]' if i < logistics.length - 1 %>">
            <p class="text-[12px] font-bold uppercase tracking-wide shrink-0 w-[38%] text-[#777]"><%= row[:label] %></p>
            <p class="text-[14px] text-[#1f1f1f] text-right flex-1"><%= row[:value] %></p>
          </div>
        <% end %>
      </section>

      <%# Products %>
      <section class="pt-6 pb-8">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-[18px] md:text-[20px] font-black text-[#1f1f1f] uppercase tracking-tight">Products</h2>
          <%= link_to "View all →", products_path(vendor: @vendor.id),
              class: "text-[14px] font-bold text-[#28ba93] no-min-h hover:underline" %>
        </div>
        <div class="flex gap-3 md:gap-4 overflow-x-auto scrollbar-none pb-2 snap-x snap-mandatory -mr-4 md:mr-0 pr-4 md:pr-0">
          <% @products.each do |product| %>
            <div class="shrink-0 w-[160px] md:w-[200px] snap-start">
              <%= render "shared/product_card", product: product, vendor: @vendor %>
            </div>
          <% end %>
        </div>
      </section>

    </main>
  </div>
</div>
