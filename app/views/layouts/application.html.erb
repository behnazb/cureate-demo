<!DOCTYPE html>
<html lang="en" data-scroll-behavior="smooth" class="h-full overflow-x-hidden">
  <head>
    <title><%= content_for(:title).presence || "Cureate Connect" %></title>
    <meta name="description" content="B2B Food Marketplace">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Lato font — matches the original Next.js font import %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:wght@300;400;700;900&display=swap">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full font-['Lato'] overflow-x-hidden flex flex-col"
        data-controller="cart"
        data-cart-storage-key-value="cureate-cart-v1">

    <%# MobileNav is always rendered; CSS hides it on md+ %>
    <%= render "shared/mobile_nav" %>

    <div class="flex-1 min-h-0 flex flex-col overflow-hidden">
      <%= yield %>
    </div>

    <%= render "shared/cart_drawer" %>
  </body>
</html>
