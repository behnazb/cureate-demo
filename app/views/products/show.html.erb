<% content_for :title, "#{@product.name} — #{@vendor.name}" %>
<% rules = @vendor.order_rules || {} %>

<div data-controller="product-detail"
     data-product-detail-vendor-id-value="<%= @vendor.id %>"
     data-product-detail-product-id-value="<%= @product.id %>"
     data-product-detail-units-per-case-value="<%= @product.units_per_case || rules[:units_per_case] || 1 %>"
     data-product-detail-units-per-item-value="<%= @product.units_per_item || 1 %>"
     data-product-detail-min-units-value="<%= rules[:min_units] || 1 %>"
     data-product-detail-min-amount-value="<%= rules[:min_amount] || 0 %>"
     data-product-detail-wholesale-unit-price-value="<%= @product.wholesale_unit_price %>"
     data-product-detail-wholesale-case-price-value="<%= @product.wholesale_case_price || 0 %>"
     data-product-detail-item-label-value="<%= @product.item_label || 'unit' %>"
     class="flex h-screen overflow-hidden font-['Lato']">

  <%= render "shared/sidebar" %>

  <main class="flex-1 overflow-y-auto bg-white">

    <%# Breadcrumb + cart — sticky so the cart stays visible on scroll (T12) %>
    <div class="sticky top-0 z-20 bg-white border-b border-[#e8e8e8] px-4 md:px-12 py-3 flex items-center justify-between gap-3">
      <span class="text-[#777] text-[14px]">
        <%= link_to "All Products", products_path, class: "hover:underline text-[#377b82]" %>
        <span class="mx-1">/</span>
        <a href="#" class="hover:underline text-[#377b82]"><%= @product.category %></a>
        <% if @product.breadcrumb %>
          <span class="mx-1">/</span>
          <a href="#" class="hover:underline text-[#377b82]"><%= @product.breadcrumb %></a>
        <% end %>
      </span>
      <%= render "shared/view_cart_button" %>
    </div>

    <%# Main grid — stacks on mobile, two columns on md+ %>
    <div class="grid grid-cols-1 md:grid-cols-[380px_1fr] gap-8 md:gap-16 px-4 md:px-12 py-6 md:py-8 max-w-6xl">

      <%# Left: image + vendor summary %>
      <div>
        <%# An un-photographed product still gets the full beige plate, so the PDP layout
            holds. See shared/_product_image. %>
        <%# Full-bleed hero — cover fills the plate; the beige only shows for the
            no-photo placeholder (overflow-hidden keeps the rounded corners). %>
        <div class="w-full rounded-xl overflow-hidden flex items-center justify-center bg-[#f7f5ef]" style="height: 400px">
          <%= render "shared/product_image", product: @product, size: :hero, fit: :cover %>
        </div>
        <div class="mt-6 flex items-center gap-3">
          <img src="<%= @vendor.logo %>" alt="<%= @vendor.name %>"
               class="w-[48px] h-[48px] rounded-full object-contain border border-[#e8e8e8]">
          <div>
            <p class="font-bold text-sm text-[#444955]"><%= @vendor.name %></p>
            <p class="text-[#777] text-[14px]"><%= @vendor.location %></p>
          </div>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% @vendor.certifications.each do |cert| %>
            <span class="inline-block border text-xs rounded-full px-3 py-1 border-[#377b82] text-[#377b82]"><%= cert %></span>
          <% end %>
        </div>
      </div>

      <%# Right: details + order section %>
      <div>
        <h1 class="font-bold mb-2 text-[#1f1f1f] text-[35px]"><%= @product.name %></h1>
        <p class="mb-4 text-[#777] text-[15px]">ID: #<%= @product.id %>&nbsp;&nbsp;|&nbsp;&nbsp;UPC: <%= @product.upc %></p>

        <div class="border-t border-dashed border-[#e8e8e8] my-4"></div>

        <p class="font-bold uppercase tracking-widest mb-3 text-[#777] text-[13px]">Product Details</p>
        <div class="grid grid-cols-3 gap-y-4 gap-x-6 mb-4">
          <%
            details = [
              { label: "Size",                  value: @product.size },
              { label: "Wholesale Unit Price",  value: "$#{format('%.2f', @product.wholesale_unit_price)}" },
              { label: "MSRP",                  value: @product.msrp ? "$#{format('%.2f', @product.msrp)}" : "—" },
              { label: "Units by Case",         value: @product.units_per_case&.to_s || "—" },
              { label: "Wholesale Case Price",  value: @product.wholesale_case_price ? "$#{format('%.2f', @product.wholesale_case_price)}" : "—" },
              { label: "Case Minimum",          value: @product.case_minimum&.to_s || "—" },
            ]
          %>
          <% details.each do |d| %>
            <div>
              <p class="uppercase tracking-wide mb-1 text-[#777] text-[13px]"><%= d[:label] %></p>
              <p class="font-bold text-[#444955] text-[16px]"><%= d[:value] %></p>
            </div>
          <% end %>
        </div>

        <div class="border-t border-dashed border-[#e8e8e8] my-4"></div>
        <p class="font-bold uppercase tracking-widest mb-2 text-[#777] text-[13px]">Storage & Shelf Life</p>
        <div class="flex flex-col gap-0.5">
          <% (@product.storage || "").split(",").map(&:strip).reject(&:empty?).each do |line| %>
            <p class="text-[#444955] text-[16px]">• <%= line %></p>
          <% end %>
        </div>

        <div class="border-t border-dashed border-[#e8e8e8] my-4"></div>
        <p class="font-bold uppercase tracking-widest mb-2 text-[#777] text-[13px]">Allergen-Friendly</p>
        <div class="flex flex-wrap gap-x-6 gap-y-1 mt-2">
          <% @product.allergens.each do |allergen| %>
            <div class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full inline-block shrink-0 bg-[#28ba93]"></span>
              <span class="text-[#444955] text-[16px]"><%= allergen %></span>
            </div>
          <% end %>
        </div>

        <div class="border-t border-dashed border-[#e8e8e8] my-4"></div>
        <p class="font-bold uppercase tracking-widest mb-2 text-[#777] text-[13px]">Dietary Preferences</p>
        <div class="grid grid-cols-[repeat(auto-fill,minmax(84px,1fr))] gap-x-2 gap-y-4 mt-2">
          <% @product.dietary.each do |pref| %>
            <div class="flex flex-col items-center text-center">
              <div class="w-10 h-10 rounded-full flex items-center justify-center text-white text-xs font-bold bg-[#035257] shrink-0">
                <%= @product.dietary_abbr(pref) %>
              </div>
              <span class="mt-1.5 text-[#444955] text-[13px] leading-tight"><%= pref %></span>
            </div>
          <% end %>
        </div>

        <%# Order section %>
        <div class="mt-8">
          <div class="flex items-start gap-3 rounded-xl p-4 mb-6 border bg-[#f7f5ef] border-[#e8e8e8]">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" class="shrink-0 text-[#28ba93] mt-[3px]" aria-hidden="true">
              <circle cx="10" cy="10" r="8.5" stroke="currentColor" stroke-width="1.4"/>
              <line x1="10" y1="9" x2="10" y2="14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              <circle cx="10" cy="6.3" r="0.65" fill="currentColor"/>
            </svg>
            <div>
              <% if rules[:min_amount] %>
                <p class="font-bold mb-0.5 text-[#444955] text-[16px]">Minimum order: $<%= rules[:min_amount] %></p>
              <% else %>
                <% min_cases = rules[:min_cases] || 1 %>
                <p class="font-bold mb-0.5 text-[#444955] text-[16px]">
                  Minimum order: <%= min_cases %> <%= min_cases == 1 ? "case" : "cases" %> (<%= rules[:min_units] %> units)<%= rules[:mix_and_match] ? " — flavors interchangeable" : "" %>
                </p>
              <% end %>
              <p class="text-[#777] text-[14px]"><%= rules[:mix_and_match_note] %></p>
            </div>
          </div>

          <%# Quantity selector row %>
          <div class="flex flex-wrap items-center gap-x-4 gap-y-3 mb-4">
            <span class="font-bold uppercase mr-2 text-[#777] text-[14px]">QTY</span>
            <div class="flex items-center border rounded-full overflow-hidden border-[#a1a4aa]">
              <button data-action="click->product-detail#decrement"
                      class="w-9 h-9 flex items-center justify-center text-lg font-bold transition-colors hover:bg-[#f7f5ef] text-[#444955] no-min-h">−</button>
              <span data-product-detail-target="qty" class="w-12 text-center font-bold text-[#444955] text-[16px]">1</span>
              <button data-action="click->product-detail#increment"
                      class="w-9 h-9 flex items-center justify-center text-lg font-bold transition-colors hover:bg-[#f7f5ef] text-[#444955] no-min-h">+</button>
            </div>
            <span class="text-[#777] text-[14px] ml-1"><%= (@product.item_label || "unit") %>s</span>
            <div class="ml-auto text-right">
              <p class="text-lg font-bold leading-tight text-[#1f1f1f]" data-product-detail-target="totalPrice">$0.00</p>
              <p class="text-[#777] text-[14px]" data-product-detail-target="totalUnits"></p>
            </div>
          </div>

          <%# Progress bar %>
          <div class="mb-6">
            <div class="flex justify-between text-xs mb-1">
              <span class="text-[#777]">Order progress</span>
              <span data-product-detail-target="progressLabel" class="text-[#777]">1 / <%= rules[:min_units] %> units min</span>
            </div>
            <div class="w-full h-2 rounded-full overflow-hidden bg-[#e8e8e8]">
              <div data-product-detail-target="progressBar"
                   class="h-full rounded-full transition-all duration-300 ease-out"
                   style="width: <%= [(1.0 / (rules[:min_units] || 1)) * 100, 100].min %>%; background-color: #377b82;"></div>
            </div>
            <p data-product-detail-target="progressLeft" class="mt-1.5 text-[#777] text-[14px]">
              Add <%= (rules[:min_units] || 1) - 1 %> more units to meet the minimum
            </p>
          </div>

          <button data-action="click->product-detail#add"
                  data-product-detail-target="addButton"
                  class="w-full text-white rounded-full py-4 font-bold flex items-center justify-center gap-2 transition-opacity text-[16px] no-min-h"
                  style="background-color: #c0c0c0; cursor: not-allowed">
            ＋ Add to Order
          </button>
          <p data-product-detail-target="addButtonHint" class="text-center mt-2 text-[#777] text-[14px]">Meet the minimum order to continue</p>
        </div>
      </div>
    </div>
  </main>

  <%# Toast %>
  <div data-product-detail-target="toast"
       data-transition="fade"
       class="fixed bottom-6 left-1/2 -translate-x-1/2 text-white text-sm px-6 py-3 rounded-full shadow-lg z-50 whitespace-nowrap bg-[#035257] inline-flex items-center gap-1.5">
    Added to order
    <span class="icon-check w-[13px] h-[13px]"></span>
  </div>
</div>
