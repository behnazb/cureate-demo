<% content_for :title, "Deliveries — 2Betties · Cureate Connect" %>
<%
  prev_month = (@month - 1).beginning_of_month
  next_month = (@month + 1).beginning_of_month
  units = ->(po) { po.line_items_for(@vendor.id).sum { |li| li.quantity.to_i } }
  weekdays = %w[Sun Mon Tue Wed Thu Fri Sat]

  # ── Responsive default view ─────────────────────────────────────────────
  # The month calendar is unusable on a phone, so until the vendor explicitly
  # picks a view we render BOTH and let CSS choose: calendar on md+, list
  # below md. An explicit ?view= choice (the toggle always sends one) wins on
  # every screen size. The server can't see the viewport, so this is the only
  # flash-free way to give mobile a different default.
  explicit      = %w[calendar list].include?(params[:view])
  show_calendar = explicit ? @view == "calendar" : true
  show_list     = explicit ? @view == "list"     : true
  calendar_wrap = explicit ? "" : "hidden md:block"
  list_wrap     = explicit ? "" : "md:hidden"
%>

<div class="flex flex-1 min-h-0 bg-white font-['Lato']">

  <%= render "shared/sidebar" %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">

    <%# ── Header: title · month nav · view toggle ────────────────────────── %>
    <div class="flex items-center justify-between px-4 md:px-9 py-4 border-b border-[#e8e8e8] bg-white shrink-0">

      <div class="flex items-center min-w-0" style="gap:20px;">
        <h1 class="text-[20px] font-bold text-[#1f1f1f] whitespace-nowrap">Deliveries</h1>

        <%#
          Month nav. Spacing is INLINE, like everything else load-bearing on this screen:
          Tailwind's gap-* classes only exist after a rebuild, and when they're missing
          the arrows and the label collapse into each other.

          The label carries a min-width (not a fixed 130px, which shoved the arrows out
          to the edges) so the arrows don't jitter as the month name changes length.
        %>
        <% if @view == "calendar" %>
          <div class="hidden md:flex items-center" style="gap:2px;">
            <%= link_to vendor_deliveries_path(month: prev_month.strftime("%Y-%m"), view: @view),
                  title: "Previous month",
                  class: "no-min-h w-7 h-7 rounded-full flex items-center justify-center hover:bg-[#f0f0f0] transition-colors shrink-0" do %>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 2.5L4.5 7 9 11.5" stroke="#1f1f1f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <% end %>

            <span class="text-[14px] font-bold text-[#1f1f1f] text-center whitespace-nowrap"
                  style="min-width:104px; padding:0 2px;"><%= @month.strftime("%B %Y") %></span>

            <%= link_to vendor_deliveries_path(month: next_month.strftime("%Y-%m"), view: @view),
                  title: "Next month",
                  class: "no-min-h w-7 h-7 rounded-full flex items-center justify-center hover:bg-[#f0f0f0] transition-colors shrink-0" do %>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 2.5L9.5 7 5 11.5" stroke="#1f1f1f" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <% end %>

            <% unless @month == @today.beginning_of_month %>
              <%= link_to "Today", vendor_deliveries_path(view: @view),
                    class: "no-min-h h-[28px] px-3 rounded-full text-[12px] font-bold text-[#777] border border-[#a1a4aa] hover:border-[#777] hover:text-[#1f1f1f] flex items-center transition-colors shrink-0",
                    style: "margin-left:8px;" %>
            <% end %>
          </div>
        <% end %>
      </div>

      <%# Calendar / list toggle — same component as the Orders page.
          Active state is class-based (not inline style) so the no-choice-yet
          default can highlight responsively: list below md, calendar on md+. %>
      <%
        cal_cls, list_cls =
          if explicit
            [@view == "calendar" ? "bg-[#1f1f1f] text-white" : "text-[#777] hover:bg-[#f0f0f0]",
             @view == "list"     ? "bg-[#1f1f1f] text-white" : "text-[#777] hover:bg-[#f0f0f0]"]
          else
            ["text-[#777] md:bg-[#1f1f1f] md:text-white",
             "bg-[#1f1f1f] text-white md:bg-transparent md:text-[#777] md:hover:bg-[#f0f0f0]"]
          end
      %>
      <div class="flex items-center gap-3 shrink-0">
        <div class="flex items-center overflow-hidden" style="border:1px solid #a1a4aa; border-radius:9999px; height:32px;">
          <%= link_to vendor_deliveries_path(view: "calendar", month: @month.strftime("%Y-%m")),
                class: "no-min-h flex items-center justify-center transition-colors #{cal_cls}",
                style: "width:40px; height:32px;", title: "Calendar" do %>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <rect x="1.5" y="2.5" width="11" height="10" rx="1.5" stroke="currentColor" stroke-width="1.3"/>
              <path d="M1.5 5.5h11M4.5 1.5v2M9.5 1.5v2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          <% end %>
          <%= link_to vendor_deliveries_path(view: "list"),
                class: "no-min-h flex items-center justify-center transition-colors #{list_cls}",
                style: "width:40px; height:32px; border-left:1px solid #a1a4aa;", title: "List" do %>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 3h12M1 7h12M1 11h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
          <% end %>
        </div>
      </div>
    </div>

    <%#
      ── Overdue (PRD story 3: "Overdue fulfillment items are flagged") ──────
      Overdue = the delivery date has passed and the order STILL hasn't gone out
      (Requested or Confirmed). Once it's in Fulfillment it has left the building and
      lateness stops being a production problem.

      This one earns a banner, unlike the tracking alert I made passive: a missed
      delivery date is the only thing on this screen a vendor can't fix by scrolling.
    %>
    <% if @overdue.any? %>
      <%# Message and pills stack on mobile (one long flex row wrapped mid-pill
          and read as noise); the pill row wraps cleanly on its own line there
          and sits ml-auto on md+. Icon is the design-system warning triangle,
          not a text glyph. %>
      <div class="px-4 md:px-9 py-3 border-b border-[#f0dede] shrink-0" style="background-color:#fdf5f5;">
        <div class="flex flex-col gap-2.5 md:flex-row md:items-center md:gap-3">
          <p class="text-[13px] text-[#1f1f1f] flex items-center gap-2.5 min-w-0">
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" class="shrink-0" style="color:#991b1b;" aria-hidden="true">
              <path d="M6 1.4L11.2 10.6H0.8L6 1.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
              <path d="M6 4.9v2.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              <circle cx="6" cy="8.9" r="0.6" fill="currentColor"/>
            </svg>
            <span><span class="font-bold"><%= pluralize(@overdue.size, "delivery") %></span> past the promised date and not yet fulfilled.</span>
          </p>
          <div class="flex flex-wrap items-center gap-2 md:ml-auto md:justify-end">
            <% @overdue.first(3).each do |po| %>
              <%= link_to "#{po.id} · #{po.delivery_date_short}", vendor_order_path(po.id),
                    class: "no-min-h text-[12px] font-bold px-3 h-[30px] rounded-full flex items-center whitespace-nowrap bg-white border border-[#e6cfcf] hover:border-[#991b1b] transition-colors",
                    style: "color:#991b1b;" %>
            <% end %>
            <% if @overdue.size > 3 %>
              <span class="text-[12px] font-bold whitespace-nowrap" style="color:#991b1b;">+ <%= @overdue.size - 3 %> more</span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# ═══════════════════════════ CALENDAR ═══════════════════════════════ %>
    <% if show_calendar %>
      <div class="<%= calendar_wrap %> flex-1 overflow-y-auto bg-white">

        <%#
          Legend — the three weights carry the whole meaning of this screen.
          Spacing inline (column-gap between entries, gap between swatch and label),
          because the Tailwind gap-* classes were missing from the build and the whole
          row collapsed into one run-on string.
        %>
        <div class="px-4 md:px-9 py-3 border-b border-[#f0f0f0]"
             style="display:flex; flex-wrap:wrap; align-items:center; column-gap:28px; row-gap:8px;">
          <span class="text-[11px] text-[#777]" style="display:inline-flex; align-items:center; gap:7px;">
            <span style="display:inline-block; width:10px; height:10px; border-radius:2px; background:#fff; border:1px dashed #c4c4c4; flex-shrink:0;"></span>
            Requested — not committed
          </span>
          <span class="text-[11px] text-[#777]" style="display:inline-flex; align-items:center; gap:7px;">
            <span style="display:inline-block; width:10px; height:10px; border-radius:2px; background:#d4f5e9; border:1px solid #a5e6d0; flex-shrink:0;"></span>
            Confirmed — make this
          </span>
          <span class="text-[11px] text-[#777]" style="display:inline-flex; align-items:center; gap:7px;">
            <span style="display:inline-block; width:10px; height:10px; border-radius:2px; background:#eef4fd; border:1px solid #d7e5fa; flex-shrink:0;"></span>
            Out for fulfillment
          </span>
        </div>

        <%#
          Tailwind's month-view structure: a 7-column grid whose 1px gaps sit over a
          tinted background, so the GAPS draw the gridlines and no per-cell borders can
          misalign.

          The grid geometry is INLINE, not `grid grid-cols-7 gap-px`. Those classes only
          exist after a Tailwind rebuild, and if the build lags, the whole calendar
          collapses into one stacked column — which is exactly what happened. Layout this
          load-bearing must not depend on a build step. Colour and type stay in Tailwind,
          where a stale build is merely cosmetic.
        %>

        <%#
          minmax(0,1fr), NOT 1fr.

          `1fr` is shorthand for `minmax(auto, 1fr)`, and that `auto` floor is the column's
          MIN-CONTENT width. The event chips are white-space:nowrap, so a long line like
          "6 cases · Port Covington HQ — Employee Café" blew its column wider than the
          others — the day cells ended up unequal while the weekday header (short words,
          no overflow) stayed equal, and the two sets of gridlines stopped agreeing.

          minmax(0,1fr) lets a column shrink below its content so the ellipsis can do its
          job. Both grids use it, so the header and the body are guaranteed identical.
        %>

        <%# Weekday header %>
        <div style="display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:1px; background:#e8e8e8; border-bottom:1px solid #e8e8e8;">
          <% weekdays.each do |d| %>
            <div class="py-2 text-[10px] font-bold uppercase tracking-wide text-[#a1a4aa] text-center" style="background:#fff; min-width:0;">
              <%= d %>
            </div>
          <% end %>
        </div>

        <%# Day cells %>
        <div style="display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:1px; background:#e8e8e8;">
          <% @weeks.flatten.each do |day| %>
            <%
              in_month = day.month == @month.month
              is_today = day == @today
              entries  = @by_date[day] || []
            %>
            <div style="background:<%= in_month ? '#ffffff' : '#f7f5ef' %>; min-height:118px; padding:6px; min-width:0; overflow:hidden;">

              <time datetime="<%= day.iso8601 %>" class="text-[11px]"
                    style="<%= is_today ? 'display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; border-radius:9999px; background:#28ba93; color:#fff; font-weight:700;' : (in_month ? 'color:#444955; font-weight:700;' : 'color:#c4c4c4;') %>">
                <%= day.day %>
              </time>

              <% if entries.any? %>
                <ol style="margin-top:5px; min-width:0;">
                  <% entries.first(3).each do |po| %>
                    <%
                      overdue = day < @today && %w[Processing Confirmed].include?(po.status)
                      style   = calendar_entry_style(po)
                      style  += " border-color:#991b1b; color:#991b1b;" if overdue
                    %>
                    <%# min-width:0 all the way down — a nowrap child anywhere in the
                        chain re-inflates the column if any ancestor can't shrink. %>
                    <li style="margin-bottom:3px; min-width:0;">
                      <%= link_to vendor_order_path(po.id),
                            title: "#{po.id} · #{po.buyer_org} · #{po.delivery_location} · #{units.call(po)} cases",
                            class: "no-min-h block hover:opacity-75 transition-opacity",
                            style: "#{style} border-radius:4px; padding:3px 5px; min-width:0; overflow:hidden;" do %>
                        <span class="text-[10px] font-bold" style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                          <%= overdue ? "⚠ " : "" %><%= po.buyer_org %>
                        </span>
                        <span class="text-[9px]" style="display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; opacity:0.8;">
                          <%= units.call(po) %> cases · <%= po.delivery_location %>
                        </span>
                      <% end %>
                    </li>
                  <% end %>
                  <% if entries.size > 3 %>
                    <li class="text-[10px] text-[#777]" style="padding-left:5px;">+ <%= entries.size - 3 %> more</li>
                  <% end %>
                </ol>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    <% end %>

    <%# ═══════ LIST — the PRD's "at least 30 days out", made literal ═══════ %>
    <% if show_list %>
      <div class="<%= list_wrap %> flex-1 overflow-y-auto bg-[#f7f5ef]">
        <div class="px-4 md:px-9 py-4 md:py-6">

          <p class="text-[12px] text-[#777] mb-4">
            Deliveries due in the next 30 days — <%= @today.strftime("%b %-d") %> to <%= (@today + 30).strftime("%b %-d, %Y") %>.
          </p>

          <% if @upcoming.empty? %>
            <div class="bg-white rounded-xl border border-[#e8e8e8] py-16 text-center">
              <p class="text-[14px] font-bold text-[#444955]">Nothing due in the next 30 days</p>
              <p class="text-[12px] text-[#777] mt-1">Confirmed orders will appear here as their delivery dates approach.</p>
            </div>
          <% end %>

          <% @upcoming.each do |date, orders| %>
            <div class="mb-4">
              <div class="flex items-center gap-2.5 mb-2">
                <span class="text-[13px] font-bold text-[#1f1f1f]"><%= date.strftime("%A, %B %-d") %></span>
                <% if date == @today %>
                  <span class="text-[10px] font-bold text-white bg-[#1f1f1f] rounded-full px-2 py-0.5">Today</span>
                <% end %>
                <span class="text-[11px] text-[#777]">
                  <%= pluralize(orders.sum { |po| units.call(po) }, "case") %> across <%= pluralize(orders.size, "order") %>
                </span>
              </div>

              <div class="bg-white rounded-xl border border-[#e8e8e8] overflow-hidden">
                <% orders.each_with_index do |po, i| %>
                  <% label, style = vendor_row_status(po, @vendor.id) %>
                  <%= link_to vendor_order_path(po.id),
                        class: "no-min-h flex items-center gap-4 px-5 py-3.5 hover:bg-[#f7f5ef] transition-colors #{'border-t border-[#f0f0f0]' if i.positive?}" do %>
                    <%# Natural width on mobile — a fixed 150px column is a third
                        of a phone screen; the aligned column returns on md+. %>
                    <div class="shrink-0 md:w-[150px]">
                      <span class="text-[13px] font-bold text-[#28ba93]"><%= po.id %></span>
                    </div>
                    <div class="flex-1 min-w-0">
                      <p class="text-[13px] text-[#1f1f1f]" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= po.buyer_org %></p>
                      <p class="text-[11px] text-[#777]" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= po.delivery_location %></p>
                    </div>
                    <%# PRD story 3: the schedule must show the PRODUCTS. It's a production
                        planning tool — "what do I have to make" is the actual question. %>
                    <div class="hidden md:block flex-1 min-w-0">
                      <p class="text-[12px] text-[#444955]" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                        <%= po.line_items_for(@vendor.id).map { |li| "#{li.quantity}× #{li.product&.name}" }.join(" · ") %>
                      </p>
                    </div>
                    <span class="shrink-0 inline-flex items-center whitespace-nowrap px-3 py-1 rounded-full text-[11px] font-bold"
                          style="<%= style %>"><%= label %></span>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
