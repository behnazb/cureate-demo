<% content_for :title, "My Profile — #{@vendor.name} · Cureate Connect" %>
<%
  # ── Shared control tokens (same family as the product drawer, so forms can't drift) ──
  card    = "bg-white border border-[#e8e8e8] rounded-xl p-5"
  label   = "text-[11px] font-bold text-[#777] uppercase tracking-wide"
  flabel  = "text-[13px] font-bold text-[#1f1f1f] mb-1"
  fhelp   = "text-[12px] text-[#777] mb-2 leading-relaxed"
  slabel  = "text-[11px] text-[#777] mb-1"
  field   = "w-full h-[38px] rounded-lg border border-[#a1a4aa] px-3 text-[13px] text-[#444955] bg-white outline-none focus:border-[#28ba93] transition-colors"
  area    = "w-full rounded-lg border border-[#a1a4aa] px-3 py-2.5 text-[13px] text-[#444955] bg-white outline-none focus:border-[#28ba93] transition-colors leading-relaxed"
  # Dropdowns: 12px left padding; .select-chevron replaces the native arrow with
  # a custom one sitting exactly 12px from the right border (see tailwind css).
  sel     = "#{field.sub('px-3', 'pl-3')} select-chevron cursor-pointer"
  req     = '<span style="color:#d9534f;">*</span>'.html_safe


  # ── Option lists — 1:1 with the production Connect edit view ──
  business_type_options = ["Corporation", "Partnership", "Sole Proprietorship", "Family-owned", "Social Enterprise"]
  # Granular Revenue + Employees dropdowns (Kim, Aug 3 — revenue/jobs growth tracking).
  # Current seed value is merged in so legacy buckets still preselect.
  revenue_options = ["1-50,000", "51,000-100,000", "101,000-150,000", "151,000-200,000",
                     "201,000-250,000", "251,000-300,000", "301,000-400,000", "401,000-500,000",
                     "501,000-600,000", "601,000-700,000", "701,000-800,000", "801,000-900,000",
                     "901,000-1,000,000", "1,100,000-1,500,000", "1,500,000-2,000,000",
                     "2,100,000-3,000,000", "3,100,000-4,000,000", "4,100,000-5,000,000",
                     "5,000,000+"] | [@vendor.revenue.to_s].reject(&:blank?)
  certification_options = ["Woman-owned Business", "Minority-owned Business"]
  employee_options      = ["1", "2-5", "6-10", "11-15", "16-20", "21-25", "26-30", "31-34",
                           "36-40", "41-45", "46-50", "50+"] | [@vendor.employees.to_s].reject(&:blank?)
  insurance_options     = ["General Liability Insurance", "Auto Coverage", "Workers' Compensation"]
  state_options         = [["District of Columbia", "DC"], ["Maryland", "MD"], ["Virginia", "VA"]]

  # ── Sales Channels (tabbed — Kim's data mapping, Aug 3) ──
  # A channel with any saved data = participating; a channel with zero input
  # means the vendor is not in that channel. Fields come from the mapping sheet;
  # :product channels share the retail fulfillment block, :event channels use
  # booking availability + hot-holding/temp-log questions.
  lead_time_options  = ["24 hours", "2-3 days", "1 week", "2 weeks", "More than 2 weeks"]
  production_options = ["Daily", "Weekly", "Two weeks", "Monthly", "Quarterly"]
  # Cureate's market territories (founder's three outreach templates: DC/MD/VA,
  # Kansas City, Northwest Arkansas). Radius is a territory pick, not free text —
  # it has to be machine-readable to drive buyer-side territory filters and
  # Cureator-curated vendor visibility (Master Doc: territory filter stories,
  # State → Territory assignment).
  radius_options     = ["DC, MD, VA", "KC", "NWA"]
  foodsafety_options = ["HACCP", "GAP", "GMP", "ServSafe", "SQF", "USDA", "Organic", "Kosher", "Halal", "None", "Other"]
  channels = [
    { key: "cpg", name: "Consumer Packaged Goods", variant: :product,
      desc: "Shelf-stable retail products sold in your branded packaging — chips, beef jerky, canned drinks.",
      capacity_q: "What is your maximum order size for 1 week advance notice?",
      ops_q: "Do you use GS1 barcodes?", ops_options: %w[Yes No] },
    { key: "grab_go", name: "Grab-and-Go Fresh Retail", variant: :product,
      desc: "Fresh, perishable prepared items — sandwiches, salads, parfaits — stocked for immediate purchase.",
      capacity_q: "What is your maximum order size for 1 week advance notice?",
      ops_q: "Do you use GS1 barcodes?", ops_options: %w[Yes No] },
    { key: "boh", name: "Back-of-House Products", variant: :product,
      desc: "Bulk ingredients wholesaled to institutional kitchens — universities, hospitals, restaurant groups.",
      capacity_q: "What is your maximum order size for 1 week advance notice?",
      ops_q: "Can products be private labeled?", ops_options: %w[Yes No Depends] },
    { key: "catering", name: "Catering & Pop-Up Events", variant: :event,
      desc: "Catered drop-offs, onsite pop-ups, and event service.",
      capacity_q: "How much lead time do you need to fulfill a catering/event request?",
      ops_q: "Can you maintain hot holding during transport?", ops_options: %w[Yes No] },
    { key: "gifting", name: "Customization & Gifting", variant: :product,
      desc: "Customizable and gift-ready offerings — branded boxes, baskets, custom packaging.",
      capacity_q: "How much lead time do you need to fulfill a custom request?",
      ops_q: "Can products be private labeled?", ops_options: %w[Yes No Depends] },
    { key: "food_truck", name: "Food Truck or Cart", variant: :event,
      desc: "Bookable food truck or cart service for campuses and events.",
      capacity_q: "How much lead time do you need to fulfill a catering/event request?",
      ops_q: "Can you maintain hot holding during transport?", ops_options: %w[Yes No] },
  ]
  channel_data  = @vendor.channel_data.is_a?(Hash) ? @vendor.channel_data : {}
  cval = ->(key, f) { h = channel_data[key]; h.is_a?(Hash) ? h[f] : nil }
  carr = ->(key, f) { Array(cval.(key, f)) }
  participating = ->(key) {
    h = channel_data[key]
    h.is_a?(Hash) && h.values.any? { |v| v.is_a?(Array) ? v.any? : v.to_s.strip != "" }
  }

  # ── Shop banner library — parent → child categories (Kim's taxonomy, Aug 3) ──
  # The picker's Shop Category select lists parents; the grid shows CHILD
  # categories as thumbnails. Images live at
  #   /imgs/Shop Category/<Parent>/<child-slug>.jpg
  # (see public/imgs/Shop Category/README.md for the full expected file list);
  # a tile whose image hasn't been uploaded yet falls back to a neutral
  # placeholder via onerror in the picker JS.
  shop_categories = {
    "Beverages"             => ["Alcohol / Non-Alcoholic", "Coffee", "Juice", "Kombucha", "Milk", "Soda",
                                "Sports, Energy & Nutritional Drinks", "Tea", "Water & Sparkling Water", "Other"],
    "Bread, Rolls & Bakery" => ["Bagels", "Biscuits, Rolls & Buns", "Breads", "Donuts",
                                "Pastries, Muffins & Scones", "Tortillas & Flat Breads", "Other"],
    "Catering"              => ["Box Lunches", "Catering - Beverage Service", "Catering - Full Service",
                                "Dropoff Catering - Cold", "Dropoff Catering - Hot", "Other"],
    "Dairy & Eggs"          => ["Butter & Margarine", "Cheese", "Dairy Alternatives", "Eggs",
                                "Milk & Cream", "Yogurt", "Other"],
    "Desserts"              => ["Brownies & Bars", "Cakes & Cupcakes", "Cookies",
                                "Ice Cream & Frozen Desserts", "Pies & Tarts", "Other"],
    "Dry Goods"             => ["Baking & Mixes", "Canned Goods", "Canned Soups & Broths",
                                "Cereal, Granola & Oatmeal", "Condiments & Dressings", "Jam, Jellies & Nut Butters",
                                "Pasta & Noodles", "Rice & Grains", "Sauces & Syrups", "Spices & Seasonings", "Other"],
    "Prepared Foods"        => ["Frozen · Breakfast", "Frozen · Fruits & Vegetables", "Frozen · Meals",
                                "Frozen · Pizza", "Frozen · Sides", "Frozen · Soups", "Frozen · Other",
                                "Grab & Go · Breakfast", "Grab & Go · Fruits & Vegetables", "Grab & Go · Meals",
                                "Grab & Go · Pizza", "Grab & Go · Salads", "Grab & Go · Sandwiches & Wraps",
                                "Grab & Go · Sides", "Grab & Go · Soups", "Grab & Go · Other"],
    "Produce"               => ["Edible Flowers", "Fruit", "Herbs", "Microgreens", "Vegetables", "Other"],
    "Protein"               => ["Beef", "Charcuterie", "Chicken", "Fish", "Goat, Lamb & Veal", "Pork",
                                "Protein Alternatives", "Sausage", "Shellfish", "Turkey", "Other"],
    "Snacks"                => ["Candy & Chocolate", "Chips & Pretzels", "Crackers", "Jerky",
                                "Nutrition & Granola Bars", "Popcorn", "Trailmix, Nuts & Dried Fruits", "Other"],
    "Wellness & Gifts"      => ["Apparel & Accessories", "Bath & Body", "Books, Cards & Stationary",
                                "Candles & Aromatherapy", "Flowers", "Personal Care & Beauty", "Other"],
  }
  cat_slug = ->(s) { s.downcase.gsub("&", "and").gsub(/[^a-z0-9]+/, "-").gsub(/\A-|-\z/, "") }
  banner_categories = shop_categories.keys
  # Only children whose image actually exists render as tiles — no empty-state
  # thumbnails. Dropping a new jpg at the convention path adds its tile.
  public_root = File.join((defined?(Rails) ? Rails.root.to_s : Dir.pwd), "public")
  banner_library = shop_categories.each_with_object({}) do |(parent, children), lib|
    lib[parent] = children.filter_map { |c|
      url = "/imgs/Shop Category/#{parent}/#{cat_slug.(c)}.jpg"
      { url: url, label: c } if File.exist?(File.join(public_root, url))
    }
  end
  # Label override (Aug 5): the beef.jpg tile reads "Meats".
  Array(banner_library["Protein"]).each { |t| t[:label] = "Meats" if t[:url].end_with?("/beef.jpg") }
  picker_category = @vendor.banner_category.presence || Array(@vendor.categories).first || "Snacks"
  picker_category = "Prepared Foods" if picker_category.start_with?("Prepared Foods")
  picker_category = banner_categories.first unless banner_categories.include?(picker_category)

  sel_certs     = Array(@vendor.certifications)
  sel_insurance = @vendor.insurance.is_a?(String) ? @vendor.insurance.split(",").map(&:strip) : Array(@vendor.insurance)
  socials       = @vendor.social_links.is_a?(Hash) ? @vendor.social_links : {}
  social_val    = ->(k) { v = socials[k]; v.is_a?(String) ? v : nil }

  # Social fields — URL inputs with repo icons (public/icons/icon_<key>.svg).
  social_fields = [[:instagram, "Instagram URL"], [:tiktok, "TikTok URL"], [:facebook, "Facebook URL"], [:linkedin, "LinkedIn"]]

  # Delivery/shipping day chips + identity checklists + shop-at-a-glance (V2 mock).
  week_days         = %w[Sun Mon Tue Wed Thu Fri Sat]
  sel_delivery_days = Array(@vendor.delivery_days)
  sel_shipping_days = Array(@vendor.shipping_days)
  sel_biz_identity  = Array(@vendor.business_identity)
  sel_personal      = Array(@vendor.personal_identity)
  biz_identity_options = ["Woman-Owned Business", "Minority-Owned Business", "Veteran-Owned Business",
                          "LGBTQIA+ Owned Business", "Persons with Disabilities Owned Business"]
  personal_identity_options = ["African American", "Alaska Native", "American Indian", "Asian", "Black",
                               "Hispanic", "Latino", "Native Hawaiian", "Pacific Islander", "White"]
  live_products  = @vendor.products.reject(&:shipping_fee?).select(&:published?)
  draft_products = @vendor.products.reject(&:shipping_fee?).select(&:draft?)
%>

<div class="flex flex-1 min-h-0 bg-white font-['Lato']">
  <%= render "shared/sidebar" %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">

    <%# ── Header — title left; [Preview] [Save Profile] right. The Save button
        lives outside the <form> and submits it via the HTML form attribute. ── %>
    <div class="flex items-center justify-between px-4 md:px-9 py-4 border-b border-[#e8e8e8] bg-white shrink-0">
      <div class="flex items-center min-w-0">
        <h1 class="text-[20px] font-bold text-[#1f1f1f] whitespace-nowrap">My Profile</h1>
      </div>
      <div class="flex items-center gap-3.5 shrink-0">
        <span class="text-[12px] italic text-[#777] whitespace-nowrap hidden lg:inline">Changes appear on your page immediately.</span>
        <%# Preview SUBMITS the form first (name=preview routes the redirect to the
            public page) — a plain link here silently discarded unsaved edits. %>
        <%= button_tag "Preview", type: :submit, form: "profile-form", name: "preview", value: "1",
              class: "no-min-h border border-[#035257] text-[#035257] text-[13px] font-bold rounded-full px-5 h-[38px] hover:bg-[#f0fafa] transition-colors whitespace-nowrap inline-flex items-center" %>
        <%= button_tag "Save Profile", type: :submit, form: "profile-form", class: primary_cta_class %>
      </div>
    </div>

    <%# Flash — same treatment as Products %>
    <% if flash[:notice] %>
      <div class="px-4 md:px-9 py-2.5 border-b border-[#d4f5e9] shrink-0" style="background-color:#f0fbf7;">
        <p class="text-[12px] font-bold flex items-center gap-1.5" style="color:#065f46;">
          <span class="icon-check w-3 h-3 shrink-0"></span>
          <%= flash[:notice] %>
        </p>
      </div>
    <% end %>

    <%# ── Scrollable body — production's two-column edit view: narrow rail
        (image + structured business facts) and main column (name, socials,
        About, Business Goals, Logistics & Fulfillment). ── %>
    <div class="flex-1 overflow-y-auto px-4 md:px-9 py-6 bg-[#f7f5ef]">
      <%= form_with url: vendor_profile_path, method: :patch, local: true,
            id: "profile-form",
            html: { class: "flex flex-col gap-5 max-w-[1200px]" } do %>

        <%# ════ Shop banner (new) — Facebook-Pages pattern: persistent Edit pill,
            popover picker filtered by shop category, optimistic preview. ════ %>
        <div class="relative" data-controller="banner-picker"
             data-banner-picker-committed-value="<%= @vendor.banner_image %>"
             data-banner-picker-category-value="<%= picker_category %>"
             data-banner-picker-library-value="<%= banner_library.to_json %>">
          <div class="relative h-[240px] rounded-xl overflow-hidden border border-[#e8e8e8]" style="background-color:#e9e2d4;">
            <img data-banner-picker-target="img" src="<%= @vendor.banner_image %>" alt="Shop banner"
                 class="w-full h-full object-cover <%= 'hidden' if @vendor.banner_image.blank? %>">
            <div class="absolute inset-0 pointer-events-none" style="box-shadow: inset 0 -46px 60px -34px rgba(31,31,31,.4);"></div>
            <span class="absolute left-5 bottom-[18px] h-6 px-2.5 rounded-full text-[11px] font-bold uppercase tracking-[.06em] text-[#444] inline-flex items-center" style="background-color:rgba(255,255,255,.92);">Shop banner</span>
            <button type="button" data-action="banner-picker#toggle"
                    class="no-min-h absolute top-4 right-4 h-9 px-4 rounded-full bg-white shadow-[0_2px_8px_rgba(31,31,31,0.22)] inline-flex items-center gap-2 text-[13px] font-bold text-[#1f1f1f]">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9.9 1.8l2.3 2.3M1.8 12.2l.6-2.7 7.5-7.5a1 1 0 011.4 0l1 1a1 1 0 010 1.4l-7.6 7.4-2.9.4z" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Edit banner
            </button>
          </div>
          <p class="text-[12px] text-[#777] mt-2 px-0.5">Banner image sits at the top of your public page. We suggest photos that match your shop category.</p>

          <%# Committed selection rides Save Profile via these hidden fields. %>
          <%= hidden_field_tag :banner_image, @vendor.banner_image, data: { banner_picker_target: "hiddenUrl" } %>
          <%= hidden_field_tag :banner_category, @vendor.banner_category, data: { banner_picker_target: "hiddenCategory" } %>

          <%# ── Picker: full-page takeover on mobile, anchored popover on md+. ──
              The anchored popover clipped off both screen edges on phones, so
              below md it becomes fixed inset-0 with its own scroll (header and
              footer stay sticky). The controller locks body scroll on mobile
              while it's open. %>
          <div data-banner-picker-target="popover"
               class="hidden fixed inset-0 z-50 bg-white overflow-y-auto overscroll-contain md:absolute md:inset-auto md:top-[60px] md:right-4 md:w-[560px] md:z-40 md:overflow-visible md:border md:border-[#e2e2e2] md:rounded-xl md:shadow-[0_16px_44px_rgba(31,31,31,0.24)]">
            <div class="sticky top-0 z-10 bg-white flex items-start justify-between px-5 pt-[18px] pb-3.5 border-b border-[#f0f0f0] md:static">
              <div>
                <p class="text-[16px] md:text-[14px] font-bold text-[#1f1f1f]">Choose a banner image</p>
                <p class="text-[12px] text-[#777]" data-banner-picker-target="subtitle">Suggested for <%= picker_category %></p>
              </div>
              <button type="button" data-action="banner-picker#cancel" aria-label="Close"
                      class="no-min-h w-8 h-8 md:w-[26px] md:h-[26px] rounded-full bg-[#f4f4f4] text-[#666] text-[13px] leading-none flex items-center justify-center">&times;</button>
            </div>
            <div class="flex flex-col items-stretch gap-1.5 px-5 pt-4 pb-1 md:flex-row md:items-center md:gap-2.5">
              <label class="text-[12px] text-[#555] shrink-0">Shop category</label>
              <%# Same dropdown component as the form selects (sel token + .select-chevron).
                  md:flex-1, NOT flex-1: on mobile this row is a column, and flex-basis:0
                  overrides h-[38px] as the main size — the select collapsed to ~21px. %>
              <%= select_tag :banner_picker_category, options_for_select(banner_categories, picker_category),
                    data: { banner_picker_target: "select", action: "change->banner-picker#categoryChange" },
                    class: "#{sel} no-min-h md:flex-1",
                    form: "" %>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-3 px-5 pt-3.5 pb-1.5" data-banner-picker-target="grid"></div>
            <div class="sticky bottom-0 bg-white border-t border-[#f0f0f0] flex items-center justify-between px-5 pt-4 pb-4 md:static md:border-t-0 md:pt-5">
              <button type="button" data-action="banner-picker#remove"
                      class="no-min-h text-[12px] font-bold" style="color:#a33500;">Remove banner</button>
              <div class="flex items-center gap-2.5">
                <%# On mobile the header ✕ is the escape hatch; Cancel would crowd the row. %>
                <button type="button" data-action="banner-picker#cancel"
                        class="no-min-h hidden md:inline-flex items-center h-9 px-4 rounded-full border border-[#d8d8d8] text-[13px] font-bold text-[#444]">Cancel</button>
                <button type="button" data-action="banner-picker#commit"
                        class="no-min-h h-11 px-5 md:h-9 md:px-4 rounded-full inline-flex items-center text-[13px] font-bold text-white" style="background-color:#28ba93;">Use this image</button>
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col md:flex-row items-start gap-6">

        <%# ════ Left rail ════ %>
        <div class="w-full md:w-[280px] shrink-0 flex flex-col gap-4">

          <%# ── Images — founder photo + business logo. Hovering reveals an upload
              affordance: the overlay is a <label> wrapping a file input, and the
              image-upload Stimulus controller previews the chosen file in place. ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-3">Images</p>
            <div class="flex items-start gap-4 mb-3">
              <div>
                <div class="group relative w-[140px] h-[140px] rounded-xl border border-[#ececec] bg-[#f7f5ef] overflow-hidden" data-controller="image-upload">
                  <img data-image-upload-target="img" src="<%= @vendor.founder_photo %>" alt="Founder image"
                       class="w-full h-full object-cover <%= 'hidden' if @vendor.founder_photo.blank? %>">
                  <% if @vendor.founder_photo.blank? %>
                    <div data-image-upload-target="placeholder" class="absolute inset-0 flex items-center justify-center text-[13px] text-[#a1a4aa]">Add photo</div>
                  <% end %>
                  <label class="no-min-h absolute inset-0 flex flex-col items-center justify-center gap-1.5 text-white opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-150 cursor-pointer"
                         style="background-color:rgba(31,31,31,.58);">
                    <%= file_field_tag :founder_photo_upload, accept: "image/*", form: "",
                          class: "sr-only", data: { action: "change->image-upload#preview" } %>
                    <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M8 10.5V2.5M8 2.5L4.8 5.7M8 2.5l3.2 3.2M2.5 10.5v2a1 1 0 001 1h9a1 1 0 001-1v-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="text-[12px] font-bold">Upload Image</span>
                  </label>
                </div>
                <p class="text-[11px] text-[#777] mt-1.5">Founder Image</p>
              </div>
              <div>
                <div class="group relative w-[75px] h-[75px] rounded-[10px] border border-[#ececec] bg-white overflow-hidden flex items-center justify-center" data-controller="image-upload">
                  <img data-image-upload-target="img" src="<%= @vendor.logo %>" alt="<%= @vendor.name %> logo" class="w-full h-full object-contain p-1.5">
                  <label class="no-min-h absolute inset-0 flex flex-col items-center justify-center gap-1 text-white opacity-0 group-hover:opacity-100 focus-within:opacity-100 transition-opacity duration-150 cursor-pointer"
                         style="background-color:rgba(31,31,31,.58);">
                    <%= file_field_tag :logo_upload, accept: "image/*", form: "",
                          class: "sr-only", data: { action: "change->image-upload#preview" } %>
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none"><path d="M8 10.5V2.5M8 2.5L4.8 5.7M8 2.5l3.2 3.2M2.5 10.5v2a1 1 0 001 1h9a1 1 0 001-1v-2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    <span class="text-[10.5px] font-bold">Upload</span>
                  </label>
                </div>
                <p class="text-[11px] text-[#777] mt-1.5">Business Logo</p>
              </div>
            </div>
            <p class="text-[11px] text-[#777] italic leading-relaxed">
              Both files should be under 300kb and 300 &times; 300px in size; the profile
              image is cropped to a square.
            </p>
          </div>

          <%# ── Products in your shop ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-1.5">Products In Your Shop</p>
            <p class="text-[12px] text-[#777] mb-3">
              <span class="font-bold text-[#1f1f1f]"><%= live_products.size %></span> live
              <span class="mx-1 text-[#e8e8e8]">|</span>
              <span class="font-bold text-[#1f1f1f]"><%= draft_products.size %></span> <%= "draft".pluralize(draft_products.size) %>
            </p>
            <% if live_products.any? %>
              <div class="grid grid-cols-3 gap-2 mb-3">
                <% live_products.first(6).each do |p| %>
                  <%= link_to vendor_listings_path(edit: p.id), title: p.name,
                        class: "no-min-h block aspect-square rounded-lg bg-[#f7f5ef] border border-[#e8e8e8] overflow-hidden hover:border-[#28ba93] transition-colors" do %>
                    <% if p.image.present? %>
                      <img src="<%= p.image %>" alt="<%= p.name %>" class="w-full h-full object-cover">
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            <% end %>
            <%= link_to "Manage Products →", vendor_listings_path, class: "no-min-h text-[12px] font-bold text-[#28ba93] hover:underline" %>
          </div>

          <%# ── How buyers see you ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-2">How Buyers See You</p>
            <p class="text-[12px] text-[#777] leading-relaxed mb-3">
              This profile feeds your vendor page — story, badges, contact, and logistics.
            </p>
            <%= link_to "Preview your public page →", vendor_path(@vendor.id), class: "no-min-h text-[12px] font-bold text-[#28ba93] hover:underline" %>
          </div>

          <%# ── Business HQ location — address only; phone/email live in About ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-3">Business HQ Location</p>
            <div class="flex flex-col gap-3">
              <div>
                <p class="<%= slabel %>">Street Address</p>
                <%= text_field_tag :street_address, @vendor.street_address, class: field %>
              </div>
              <div>
                <p class="<%= slabel %>">Apt / Suite / Unit</p>
                <%= text_field_tag :address_line2, @vendor.address_line2, class: field %>
              </div>
              <div>
                <p class="<%= slabel %>">City</p>
                <%= text_field_tag :city, @vendor.city, class: field %>
              </div>
              <div>
                <p class="<%= slabel %>">State</p>
                <%= select_tag :state, options_for_select(state_options, @vendor.state), class: sel %>
              </div>
              <div>
                <p class="<%= slabel %>">Zip Code</p>
                <%= text_field_tag :zip, @vendor.zip, class: field %>
              </div>
            </div>
          </div>

          <%# ── Business details — type, revenue, size in one card ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-3">Business Details</p>
            <div class="flex flex-col gap-3.5">
              <div>
                <p class="<%= slabel %>">Business Type</p>
                <%= select_tag :business_type, options_for_select(business_type_options, @vendor.business_type), class: sel %>
              </div>
              <div>
                <p class="<%= slabel %>">Revenue</p>
                <%= select_tag :revenue, options_for_select(revenue_options, @vendor.revenue), class: sel %>
              </div>
              <div>
                <p class="<%= slabel %>">Number of Employees</p>
                <%= select_tag :employees, options_for_select(employee_options, @vendor.employees), class: sel %>
              </div>
            </div>
          </div>

          <%# ── Certifications & compliance — everything with a proof upload ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-3">Certifications &amp; Compliance</p>

            <div>
              <p class="<%= slabel %>">Business Certification</p>
              <%= select_tag :business_certification,
                    options_for_select([["Select certification…", ""]] + certification_options.map { |o| [o, o] },
                                       certification_options.find { |o| sel_certs.any? { |c| c.casecmp?(o) } }),
                    class: sel %>
              <%= file_field_tag :certification_proof, accept: "application/pdf", form: "",
                    class: "mt-3 block w-full text-[11px] text-[#777] file:mr-2 file:no-min-h file:border file:border-[#a1a4aa] file:rounded-full file:px-3 file:py-1 file:bg-white file:text-[11px] file:font-bold file:text-[#444955] file:cursor-pointer" %>
              <p class="text-[11px] text-[#777] mt-1.5">Upload your certification proof (PDF)</p>
            </div>

            <div class="h-px bg-[#f0f0f0] my-4"></div>

            <div>
              <p class="<%= slabel %>">Insurance</p>
              <%= select_tag :insurance_selection,
                    options_for_select([["Select coverage…", ""]] + insurance_options.map { |o| [o, o] },
                                       insurance_options.find { |o| sel_insurance.include?(o) }),
                    class: sel %>
              <%= file_field_tag :insurance_proof, accept: "application/pdf", form: "",
                    class: "mt-3 block w-full text-[11px] text-[#777] file:mr-2 file:no-min-h file:border file:border-[#a1a4aa] file:rounded-full file:px-3 file:py-1 file:bg-white file:text-[11px] file:font-bold file:text-[#444955] file:cursor-pointer" %>
              <p class="text-[11px] text-[#777] mt-1.5">Upload proof of insurance (PDF)</p>
            </div>

            <div class="h-px bg-[#f0f0f0] my-4"></div>

            <div>
              <p class="<%= slabel %>">Health Clearance <%= req %></p>
              <p class="text-[13px] text-[#444955] leading-snug mb-2">Have you been cleared by your state's Health Department?</p>
              <div data-controller="reveal">
                <div class="flex items-center gap-6">
                  <% [["Yes", true], ["No", false]].each do |val, is_yes| %>
                    <label class="flex items-center gap-2.5 cursor-pointer group no-min-h">
                      <%= radio_button_tag :health_clearance, val, @vendor.health_clearance == val, id: nil,
                            class: "radio-input sr-only",
                            data: is_yes ? { reveal_target: "yes", action: "change->reveal#update" } : { action: "change->reveal#update" } %>
                      <div class="radio-dot w-4 h-4 rounded-full border flex items-center justify-center shrink-0 transition-all border-[#a1a4aa] group-hover:border-[#28ba93]">
                        <span class="hidden w-2 h-2 rounded-full bg-white"></span>
                      </div>
                      <span class="text-[13px] text-[#444955]"><%= val %></span>
                    </label>
                  <% end %>
                </div>
                <div data-reveal-target="panel" class="mt-3 <%= 'hidden' unless @vendor.health_clearance == "Yes" %>">
                  <%= file_field_tag :health_clearance_proof, accept: "application/pdf", form: "",
                        class: "block w-full text-[11px] text-[#777] file:mr-2 file:no-min-h file:border file:border-[#a1a4aa] file:rounded-full file:px-3 file:py-1 file:bg-white file:text-[11px] file:font-bold file:text-[#444955] file:cursor-pointer" %>
                  <p class="text-[11px] text-[#777] mt-1.5 whitespace-nowrap">Upload proof of clearance (PDF) <%= req %></p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <%# ════ Main column ════ %>
        <div class="flex-1 min-w-0 flex flex-col gap-4">

          <%# ── About — business identity, contact points, socials (per Aug 3 screenshot) ── %>
          <div class="<%= card %>">
            <p class="<%= label %>">About</p>
            <div class="flex flex-col gap-5 mt-4">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <p class="<%= flabel %>">Business Name <%= req %></p>
                  <%= text_field_tag :name, @vendor.name, required: true, class: field %>
                </div>
                <div>
                  <p class="<%= flabel %>">Business Owner Name(s) <%= req %></p>
                  <%= text_field_tag :owner_names, @vendor.owner_names, required: true, class: field %>
                </div>
                <div>
                  <p class="<%= flabel %>">Ownership Type <%= req %></p>
                  <%= select_tag :business_type, options_for_select(business_type_options, @vendor.business_type), class: sel %>
                </div>
                <div>
                  <p class="<%= flabel %>">Business Website <%= req %></p>
                  <%= text_field_tag :website, @vendor.website, required: true, placeholder: "https://", class: field %>
                </div>
              </div>
              <div>
                <div class="flex flex-col md:flex-row gap-4">
                  <div class="flex-1 min-w-0">
                    <p class="<%= flabel %>">Business Email <%= req %></p>
                    <%= text_field_tag :email, @vendor.email, required: true, class: field %>
                  </div>
                  <div class="md:w-[220px] shrink-0">
                    <p class="<%= flabel %>">Phone <%= req %></p>
                    <%= telephone_field_tag :phone, @vendor.phone, required: true, class: field %>
                  </div>
                </div>
                <%# Note sits BELOW the inputs, spanning both columns — keeps the
                    row's spacing intact when it stacks on tablet/mobile. %>
                <p class="text-[12px] italic text-[#777] mt-1.5">This address will be used to conduct business with Cureate. It will not be listed publicly.</p>
              </div>
              <div>
                <p class="<%= flabel %> mb-2">Social Media Addresses</p>
                <div class="grid grid-cols-2 xl:grid-cols-4 gap-3">
                  <% social_fields.each do |key, ph| %>
                    <div class="flex items-center gap-2 rounded-lg border border-[#a1a4aa] px-3 h-[38px] bg-white focus-within:border-[#28ba93] transition-colors">
                      <img src="/icons/icon_<%= key %>.svg" alt="" class="w-4 h-4 shrink-0 opacity-70">
                      <%= text_field_tag key, social_val.(key), placeholder: ph,
                            class: "no-min-h w-full h-full text-[13px] text-[#444955] bg-transparent outline-none border-0 p-0" %>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <%# ── Your Business — description, story, production, sales channels ── %>
          <div class="<%= card %>">
            <p class="<%= label %>">Your Business</p>
            <div class="flex flex-col gap-5 mt-4">
              <div>
                <p class="<%= flabel %>">About Your Business <%= req %></p>
                <p class="<%= fhelp %>">A brief description of your company and the products or services you offer.</p>
                <%= text_area_tag :about, @vendor.about, rows: 2, required: true, class: area %>
              </div>
              <div>
                <p class="<%= flabel %>">What's Your Story? <%= req %></p>
                <p class="<%= fhelp %>">How did you get started? Who do you serve? What makes your business, or your experiences as an owner, unique?</p>
                <%= text_area_tag :story, @vendor.story, rows: 2, required: true, class: area %>
              </div>

              <div>
                <p class="<%= flabel %>">Production</p>
                <p class="<%= fhelp %>">Where do you currently produce?</p>
                <%= text_field_tag :production, @vendor.production,
                      placeholder: "e.g. Production kitchen in Locust Point, Baltimore — or your co-packer's facility and city",
                      class: field %>
              </div>
            </div>
          </div>

          <%# ── Logistics & fulfillment ── %>
          <div class="<%= card %>">
            <p class="<%= label %>">Logistics &amp; Fulfillment</p>
            <div class="flex flex-col gap-5 mt-4">
              <div>
                <p class="<%= flabel %>">Delivery Schedule <%= req %></p>
                <p class="<%= fhelp %>">What day(s) of the week do you deliver and/or ship? Select all that apply</p>
                <div class="flex flex-col md:flex-row gap-4 md:gap-10">
                  <div>
                    <p class="text-[12px] text-[#777] mb-1.5">Delivery Day(s)</p>
                    <div class="flex flex-wrap gap-1.5">
                      <% week_days.each do |d| %>
                        <label class="no-min-h cursor-pointer">
                          <%= check_box_tag "delivery_days[]", d, sel_delivery_days.include?(d), id: nil, class: "daychip-input sr-only" %>
                          <span class="daychip inline-flex items-center h-7 px-[11px] rounded-full border border-[#d8d8d8] bg-white text-[12px] text-[#444955] transition-colors hover:border-[#28ba93]"><%= d %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>
                  <div>
                    <p class="text-[12px] text-[#777] mb-1.5">Shipping Day(s)</p>
                    <div class="flex flex-wrap gap-1.5">
                      <% week_days.each do |d| %>
                        <label class="no-min-h cursor-pointer">
                          <%= check_box_tag "shipping_days[]", d, sel_shipping_days.include?(d), id: nil, class: "daychip-input sr-only" %>
                          <span class="daychip inline-flex items-center h-7 px-[11px] rounded-full border border-[#d8d8d8] bg-white text-[12px] text-[#444955] transition-colors hover:border-[#28ba93]"><%= d %></span>
                        </label>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
              <div>
                <p class="<%= flabel %>">Seasonal Offerings</p>
                <p class="<%= fhelp %>">Do you offer seasonal products and/or services? Tell us more about the frequency in which you rotate your products (Quarterly? By holiday? By calendar season?)</p>
                <%= text_area_tag :seasonal_offerings, @vendor.seasonal_offerings, rows: 2, class: area %>
              </div>
              <div>
                <p class="<%= flabel %>">Marketing Opportunities</p>
                <p class="<%= fhelp %>">Do you demo, host pop-ups or provide samples?</p>
                <div class="flex flex-wrap items-center gap-6" data-controller="reveal">
                  <% [["Yes", true], ["No", false]].each do |val, is_yes| %>
                    <label class="flex items-center gap-2.5 py-1 cursor-pointer group no-min-h">
                      <%= radio_button_tag :marketing_opportunities, val, @vendor.marketing_opportunities == val, id: nil,
                            class: "radio-input sr-only",
                            data: is_yes ? { reveal_target: "yes", action: "change->reveal#update" } : { action: "change->reveal#update" } %>
                      <div class="radio-dot w-4 h-4 rounded-full border flex items-center justify-center shrink-0 transition-all border-[#a1a4aa] group-hover:border-[#28ba93]">
                        <span class="hidden w-2 h-2 rounded-full bg-white"></span>
                      </div>
                      <span class="text-[13px] text-[#444955]"><%= val %></span>
                    </label>
                  <% end %>
                  <div data-reveal-target="panel" class="w-full <%= 'hidden' unless @vendor.marketing_opportunities == "Yes" %>">
                    <%= text_area_tag :marketing_opportunities_details, @vendor.marketing_opportunities_details, rows: 2, class: area,
                          placeholder: "Tell us about the demos, pop-ups, or sampling you offer — where, how often, and anything you need from the buyer." %>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <%# ── Sales Channels — channel cards + edit drawer (Kim's data mapping).
              Participation is derived: a channel with saved details is one the
              vendor operates in; "Remove from my channels" clears it. ── %>
          <div class="<%= card %>" data-controller="channel-drawer">
            <p class="<%= label %>">Sales Channels</p>
            <p class="text-[12px] text-[#777] mt-1 mb-4 leading-relaxed">
              Six ways vendors sell through Cureate. Open a channel and fill in how you operate —
              a channel with details is shown to buyers as one you participate in. Channels left
              empty won't appear on your page.
            </p>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
              <% channels.each do |ch| %>
                <% on = participating.(ch[:key]) %>
                <div data-channel-drawer-target="card" data-channel="<%= ch[:key] %>"
                     class="rounded-xl border p-4 transition-colors flex flex-col <%= on ? 'border-[#28ba93] bg-[#f6fcfa]' : 'border-[#e8e8e8] bg-white' %>">
                  <div class="flex items-start justify-between gap-3 mb-1">
                    <p class="text-[14px] font-bold text-[#1f1f1f]"><%= ch[:name] %></p>
                    <span data-channel-drawer-target="badge" data-channel="<%= ch[:key] %>"
                          class="shrink-0 inline-flex items-center h-[22px] px-2 rounded-full text-[10.5px] font-bold uppercase tracking-wide whitespace-nowrap"
                          style="background-color:<%= on ? '#eaf7f3' : '#f4f4f4' %>; color:<%= on ? '#0f7a63' : '#a1a4aa' %>;"><%= on ? "Active" : "Not participating" %></span>
                  </div>
                  <p class="text-[12px] text-[#777] leading-relaxed mb-3 flex-1"><%= ch[:desc] %></p>
                  <div>
                    <button type="button" data-action="channel-drawer#open" data-channel="<%= ch[:key] %>"
                            class="no-min-h h-8 px-3.5 rounded-full border border-[#035257] text-[#035257] text-[12px] font-bold hover:bg-[#f0fafa] transition-colors">Edit details</button>
                  </div>
                </div>
              <% end %>
            </div>

            <%# ── Shared backdrop + per-channel drawers — the SAME drawer system as
                the buyer cart drawer (shared/_cart_drawer): data-transition CSS
                slide-in-right panel + fade backdrop, cream #f7f5ef panel, sticky
                50px header with 14px X, white rounded-20 shadow content card,
                and a cream CTA bar. Inputs stay inside the profile form. ── %>
            <div data-channel-drawer-target="backdrop" data-action="click->channel-drawer#close"
                 data-transition="fade" class="hidden md:block fixed inset-0 bg-black/30 z-[70]"></div>
            <% channels.each do |ch| %>
              <% k = ch[:key] %>
              <aside data-channel-drawer-target="drawer" data-channel="<%= k %>" data-transition="slide-in-right"
                     class="fixed top-0 right-0 h-full w-full md:w-[520px] z-[80] overflow-hidden bg-[#f7f5ef] font-['Lato']">
                <div class="flex flex-col h-full relative">
                  <div class="flex-1 flex flex-col overflow-y-auto min-h-0">
                    <div class="sticky top-0 z-10 flex items-center justify-between px-4 shrink-0 border-b-2 h-[50px] border-[#e6e6e6] bg-[#f7f5ef]">
                      <span class="font-bold text-[#1f1f1f] text-[14px]"><%= ch[:name] %></span>
                      <button type="button" data-action="click->channel-drawer#close" aria-label="Close"
                              class="no-min-h flex items-center justify-center w-6 h-6 hover:opacity-70 transition-opacity text-[#1f1f1f]">
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                      </button>
                    </div>
                    <div class="px-4 py-4 flex flex-col gap-3">
                      <p class="text-[12px] text-[#777] leading-relaxed px-1"><%= ch[:desc] %></p>
                      <div class="bg-white p-4" style="border-radius: 20px; box-shadow: 2px 2px 10px 0px rgba(156,153,153,0.25);">
                <%# One question per row, full width. Two-up only where BOTH
                    labels are minimal and can never wrap in the 520px panel —
                    a wrapped label in a paired row breaks the vertical rhythm
                    of the whole form. Sections separated by the same hairline
                    the Certifications & Compliance card uses. %>
                <div class="flex flex-col gap-4">
                  <%# Total MOQ — structured per the MOQ PRD: a machine-readable
                      measure (units | dollars) + numeric threshold, plus an
                      optional buyer-facing label. A channel's MOQ maps to a
                      group-level rule (channel's products = an MoqGroup). %>
                  <div>
                    <p class="<%= slabel %>">Total MOQ</p>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <p class="text-[11px] text-[#777] mb-1">Minimum amount</p>
                        <%= number_field_tag "channels[#{k}][moq_threshold]", cval.(k, "moq_threshold"),
                              min: 0, placeholder: "e.g. 36", class: field %>
                      </div>
                      <div>
                        <p class="text-[11px] text-[#777] mb-1">Measured in</p>
                        <%= select_tag "channels[#{k}][moq_measure]",
                              options_for_select([["Select…", ""], ["Units", "Units"], ["Dollars ($)", "Dollars ($)"]], cval.(k, "moq_measure")), class: sel %>
                      </div>
                    </div>
                    <div class="mt-3">
                      <p class="text-[11px] text-[#777] mb-1">Shown to buyers as (optional)</p>
                      <%= text_field_tag "channels[#{k}][moq_label]", cval.(k, "moq_label"),
                            placeholder: "e.g. 1 case (36 units) per order — flavors mix-and-match", class: field %>
                    </div>
                  </div>
                  <div>
                    <p class="<%= slabel %>">How much lead time do you typically require?</p>
                    <%= select_tag "channels[#{k}][lead_time]",
                          options_for_select([["Select…", ""]] + lead_time_options.map { |o| [o, o] }, cval.(k, "lead_time")), class: sel %>
                  </div>
                  <div>
                    <p class="<%= slabel %>">How far in advance do you plan production?</p>
                    <%= select_tag "channels[#{k}][production_planning]",
                          options_for_select([["Select…", ""]] + production_options.map { |o| [o, o] }, cval.(k, "production_planning")), class: sel %>
                  </div>
                  <div>
                    <p class="<%= slabel %>"><%= ch[:capacity_q] %></p>
                    <%= text_field_tag "channels[#{k}][capacity]", cval.(k, "capacity"), class: field %>
                  </div>
                </div>

                <div class="mt-5 border-t border-[#f0f0f0]"></div>
                <p class="<%= label %> mt-4 mb-3">Fulfillment</p>
                <% if ch[:variant] == :product %>
                  <div class="flex flex-col gap-4">
                    <%# The one earned pair: both questions are short enough to
                        never wrap side-by-side. %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <p class="<%= slabel %>">Do you deliver, ship, or both?</p>
                        <%= select_tag "channels[#{k}][fulfillment_method]",
                              options_for_select([["Select…", ""], ["Deliver", "Deliver"], ["Ship", "Ship"], ["Both", "Both"]], cval.(k, "fulfillment_method")), class: sel %>
                      </div>
                      <div>
                        <p class="<%= slabel %>">Who delivers?</p>
                        <%= select_tag "channels[#{k}][who_delivers]",
                              options_for_select([["Select…", ""], ["We deliver", "We deliver"], ["Third-party courier", "Third-party courier"], ["Distributor", "Distributor"]], cval.(k, "who_delivers")), class: sel %>
                      </div>
                    </div>
                    <div>
                      <p class="<%= slabel %>">Delivery fee / estimated S&amp;H fee</p>
                      <%= text_field_tag "channels[#{k}][delivery_fee]", cval.(k, "delivery_fee"), placeholder: "e.g. $10 flat delivery", class: field %>
                    </div>
                    <div>
                      <p class="<%= slabel %>">Delivery radius</p>
                      <%= select_tag "channels[#{k}][delivery_radius]",
                            options_for_select([["Select…", ""]] + radius_options.map { |o| [o, o] }, cval.(k, "delivery_radius")), class: sel %>
                    </div>
                    <div>
                      <p class="<%= slabel %>">Shipping radius</p>
                      <%= select_tag "channels[#{k}][shipping_radius]",
                            options_for_select([["Select…", ""]] + radius_options.map { |o| [o, o] }, cval.(k, "shipping_radius")), class: sel %>
                    </div>
                    <div>
                      <p class="<%= slabel %> mb-1.5">Shipping carrier</p>
                      <div class="flex flex-wrap gap-x-4">
                        <% %w[USPS UPS FedEx].each do |o| %>
                          <%= render "check_option", name: "channels[#{k}][carriers][]", value: o, checked: carr.(k, "carriers").include?(o) %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                <% else %>
                  <div class="flex flex-col gap-4">
                    <div>
                      <p class="<%= slabel %> mb-1.5">Days of week available for booking</p>
                      <div class="flex flex-wrap gap-1.5">
                        <% week_days.each do |d| %>
                          <label class="no-min-h cursor-pointer">
                            <%= check_box_tag "channels[#{k}][booking_days][]", d, carr.(k, "booking_days").include?(d), id: nil, class: "daychip-input sr-only" %>
                            <span class="daychip inline-flex items-center h-7 px-[11px] rounded-full border border-[#d8d8d8] bg-white text-[12px] text-[#444955] transition-colors hover:border-[#28ba93]"><%= d %></span>
                          </label>
                        <% end %>
                      </div>
                    </div>
                    <div>
                      <p class="<%= slabel %>">Delivery fee</p>
                      <%= text_field_tag "channels[#{k}][delivery_fee]", cval.(k, "delivery_fee"), placeholder: "e.g. $50 — covers setup and staff", class: field %>
                    </div>
                    <div>
                      <p class="<%= slabel %>">Delivery radius</p>
                      <%= select_tag "channels[#{k}][delivery_radius]",
                            options_for_select([["Select…", ""]] + radius_options.map { |o| [o, o] }, cval.(k, "delivery_radius")), class: sel %>
                    </div>
                  </div>
                <% end %>

                <div class="mt-5 border-t border-[#f0f0f0]"></div>
                <p class="<%= label %> mt-4 mb-3">Operations &amp; Food Safety</p>
                <div class="flex flex-col gap-4">
                  <div>
                    <p class="<%= slabel %>"><%= ch[:ops_q] %></p>
                    <%= select_tag "channels[#{k}][ops]",
                          options_for_select([["Select…", ""]] + ch[:ops_options].map { |o| [o, o] }, cval.(k, "ops")), class: sel %>
                  </div>
                  <% if ch[:variant] == :event %>
                    <div>
                      <p class="<%= slabel %>">Are you able and willing to keep temp logs?</p>
                      <%= select_tag "channels[#{k}][temp_logs]",
                            options_for_select([["Select…", ""], ["Yes", "Yes"], ["No", "No"]], cval.(k, "temp_logs")), class: sel %>
                    </div>
                  <% end %>
                </div>
                <% if ch[:variant] == :product %>
                  <div class="mt-4">
                    <p class="<%= slabel %> mb-1">Which certifications do you currently maintain?</p>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-x-4">
                      <% foodsafety_options.each do |o| %>
                        <%= render "check_option", name: "channels[#{k}][certifications][]", value: o, checked: carr.(k, "certifications").include?(o) %>
                      <% end %>
                    </div>
                    <%# "Other" reveals a details field (toggled by channel-drawer#refresh) %>
                    <div data-channel-drawer-target="otherField" data-channel="<%= k %>"
                         class="mt-2 <%= 'hidden' unless carr.(k, "certifications").include?("Other") %>">
                      <p class="<%= slabel %>">Tell us about your other certification(s)</p>
                      <%= text_field_tag "channels[#{k}][certifications_other]", cval.(k, "certifications_other"),
                            placeholder: "e.g. Cottage Food License, state-specific permits", class: field %>
                    </div>
                  </div>
                <% end %>
                      </div>
                    </div>
                  </div>
                  <%# CTA bar — cream footer, same treatment as the cart drawer %>
                  <div class="shrink-0 border-t-2 border-[#e6e6e6] bg-[#f7f5ef] px-4 py-3 flex items-center justify-between gap-3">
                    <button type="button" data-action="channel-drawer#removeChannel" data-channel="<%= k %>"
                            class="no-min-h text-[12px] font-bold" style="color:#a33500;">Remove from my channels</button>
                    <button type="button" data-action="channel-drawer#close" class="<%= primary_cta_class %>">Done</button>
                  </div>
                </div>
              </aside>
            <% end %>
          </div>

          <%# ── Identity — business badges + optional self-identification ── %>
          <div class="<%= card %>">
            <p class="<%= label %>">Identity</p>
            <div class="flex flex-col gap-5 mt-3">
              <div>
                <p class="text-[13px] font-bold text-[#1f1f1f] mb-0.5">Does your business identify as any of the following?</p>
                <p class="text-[12px] text-[#777] mb-2">These power the attribute badges and filters buyers see on the marketplace.</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-4">
                  <% biz_identity_options.each do |o| %>
                    <%= render "check_option", name: "business_identity[]", value: o, checked: sel_biz_identity.include?(o) %>
                  <% end %>
                </div>
              </div>
              <div>
                <p class="text-[13px] font-bold text-[#1f1f1f] mb-0.5">Do you identify as any of the following?</p>
                <p class="text-[12px] text-[#777] mb-2">Optional — used by Cureate for community programs and reporting. Never shown to buyers.</p>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-x-4">
                  <% personal_identity_options.each do |o| %>
                    <%= render "check_option", name: "personal_identity[]", value: o, checked: sel_personal.include?(o) %>
                  <% end %>
                </div>
              </div>
            </div>
          </div>

          <%# ── Downloadables — stub; upload wiring comes with the PDF-certification round ── %>
          <div class="<%= card %>">
            <p class="<%= label %> mb-1.5">Downloadables</p>
            <p class="text-[12px] text-[#777] mb-3">Spec sheets, sell sheets, certificates. Buyers can download these from your product page.</p>
            <button type="button" class="no-min-h inline-flex items-center gap-1.5 h-9 px-4 rounded-full border border-[#a1a4aa] bg-white text-[13px] font-bold text-[#444955] hover:border-[#28ba93] transition-colors">
              <span class="text-[15px] leading-none">+</span> Add File
            </button>
          </div>
        </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
