<% content_for :title, "Products — 2Betties · Cureate Connect" %>
<%
  tabs = [["all", "All"], ["published", "Published"], ["draft", "Drafts"], ["attention", "Needs attention"]]
%>

<div class="flex flex-1 min-h-0 bg-white font-['Lato']"
     data-controller="product-drawer"
     data-auto-open="<%= @editing ? 'true' : 'false' %>">

  <%= render "shared/sidebar" %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">

    <%#
      ── Header ─────────────────────────────────────────────────────────────
      The CTA is the buyer's "Add to Draft PO" pill, re-labelled. Same shape, same green,
      same top-right position — a vendor who has used the buyer side already knows where
      the primary action lives.
    %>
    <div class="flex items-center justify-between px-4 md:px-9 py-4 border-b border-[#e8e8e8] bg-white shrink-0">
      <div class="flex items-center min-w-0" style="gap:20px;">
        <h1 class="text-[20px] font-bold text-[#1f1f1f] whitespace-nowrap">Products</h1>
        <span class="text-[12px] text-[#777] whitespace-nowrap"><%= pluralize(@counts["published"], "live listing") %></span>
      </div>

      <%# Shared primary-CTA token — same button as the buyer's "New Purchase Order". %>
      <button type="button" data-action="product-drawer#open" class="<%= primary_cta_class('shrink-0') %>">
        <%= cta_plus_icon %>
        Add New Product
      </button>
    </div>

    <%# Flash %>
    <% if flash[:notice] %>
      <div class="px-4 md:px-9 py-2.5 border-b border-[#d4f5e9] shrink-0" style="background-color:#f0fbf7;">
        <p class="text-[12px] font-bold flex items-center gap-1.5" style="color:#065f46;">
          <span class="icon-check w-3 h-3 shrink-0"></span>
          <%= flash[:notice] %>
        </p>
      </div>
    <% end %>

    <%# Filter tabs — same pill tabs as Orders %>
    <div class="flex items-center px-4 md:px-9 py-3 border-b border-[#e8e8e8] bg-white shrink-0" style="gap:4px;">
      <% tabs.each do |value, label| %>
        <% active = @filter == value %>
        <%= link_to vendor_listings_path(filter: value),
              class: "no-min-h px-4 h-[32px] rounded-full text-[12px] font-bold whitespace-nowrap flex items-center transition-colors #{active ? 'bg-[#1f1f1f] text-white' : 'text-[#777] hover:text-[#1f1f1f] hover:bg-[#f0f0f0]'}",
              style: "gap:6px;" do %>
          <span><%= label %></span>
          <% if @counts[value].to_i.positive? %>
            <span class="text-[10px] font-black px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20 text-white' : 'bg-[#e8e8e8] text-[#555]' %>"><%= @counts[value] %></span>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <%#
      ── Gallery ──────────────────────────────────────────────────────────────
      White canvas, not the warm #f7f5ef used on the order pages. Here the beige is doing
      a different job: it's the plate BEHIND each product photo. Putting beige on beige
      flattened the cards into the page. White gives the image plates something to sit on.
    %>
    <div class="flex-1 overflow-y-auto bg-white px-4 md:px-9 py-4 md:py-6">

      <% if @visible.empty? %>
        <div class="bg-white border border-[#e8e8e8] rounded-xl py-16 text-center">
          <p class="text-[14px] font-bold text-[#444955]">No products here yet</p>
          <p class="text-[12px] text-[#777] mt-1">Add your first product to get it on the marketplace.</p>
        </div>
      <% else %>
        <%# Inline grid — the arbitrary-value grid classes are exactly what keeps vanishing
            from the build, so the geometry doesn't live there. %>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(230px, 1fr)); gap:20px;">
          <% @visible.each do |product| %>
            <%= link_to vendor_listings_path(edit: product.id, filter: @filter),
                  class: "no-min-h block bg-white border border-[#e8e8e8] rounded-xl overflow-hidden hover:shadow-[2px_2px_10px_0px_rgba(156,153,153,0.25)] transition-shadow" do %>

              <%#
                Image — gallery treatment, contained on beige. When there ISN'T one, the
                vendor sees a prompt rather than a void: a missing photo is a job they can
                do, and it's the single biggest thing hurting the listing on the buyer side.
              %>
              <div class="relative bg-[#f7f5ef] flex items-center justify-center overflow-hidden"
                   style="aspect-ratio:1/1; padding:14px;">
                <%= render "shared/product_image", product: product, size: :card %>

                <%# Draft overlays the image — it changes what the card MEANS. %>
                <% if product.draft? %>
                  <span class="absolute text-[10px] font-bold px-2.5 py-1 rounded-full"
                        style="top:10px; left:10px; background:#1f1f1f; color:#fff;">Draft</span>
                <% end %>

                <%#
                  The missing-photo flag sits ON the image well — the thing it's about, and
                  the thing the vendor clicks to fix. The card's data rows (name, ID, price,
                  stock) stay intact; a flag shouldn't cost the vendor a fact.

                  Red because this one genuinely costs orders: a listing with no photo gets
                  scrolled past. It's the only listing gap that earns red.
                %>
                <% if product.image.blank? %>
                  <span class="absolute flex items-center justify-center text-[10px] font-bold"
                        style="left:0; right:0; bottom:0; padding:7px 10px; background:#fce8e8; color:#991b1b; gap:5px;">
                    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" class="shrink-0" aria-hidden="true">
                      <path d="M6 1.4L11.2 10.6H0.8L6 1.4Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                      <path d="M6 4.9v2.2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                      <circle cx="6" cy="8.9" r="0.6" fill="currentColor"/>
                    </svg>
                    Product Photo Required
                  </span>
                <% end %>
              </div>

              <div class="p-3.5">
                <p class="text-[13px] font-bold text-[#1f1f1f]"
                   style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= product.name %></p>

                <p class="text-[11px] text-[#999] mt-0.5">ID #<%= product.id %></p>

                <div class="flex items-center justify-between" style="margin-top:10px;">
                  <span class="text-[13px] font-black text-[#1f1f1f]">$<%= format("%.2f", product.wholesale_unit_price.to_f) %></span>
                  <%
                    inv = product.inventory.to_i
                    inv_bg, inv_fg = if inv.zero?    then ["#fce8e8", "#991b1b"]
                                     elsif inv < 50  then ["#fde8dc", "#a33500"]
                                     else                 ["#f0f0f0", "#444955"]
                                     end
                  %>
                  <span class="text-[11px] font-bold px-2.5 py-1 rounded-full whitespace-nowrap"
                        style="background:<%= inv_bg %>; color:<%= inv_fg %>;">
                    <%= inv.zero? ? "Out of stock" : "#{number_with_delimiter(inv)} on hand" %>
                  </span>
                </div>
                <%# No completeness meter here. The card shows the product; the "Add photo"
                    placeholder already says the one thing that matters, and the nudge card
                    at the top of the page carries the rest. %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%= render "drawer", vendor: @vendor, product: @editing %>
</div>
