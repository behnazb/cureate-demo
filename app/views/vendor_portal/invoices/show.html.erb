<% content_for :title, "#{@po.invoice_number} — 2Betties · Cureate Connect" %>
<%
  st = @po.invoice_display_status
  inv_colors = {
    "Submitted"       => ["#f0f0f0", "#444955"],
    "Approved"        => ["#d4f5e9", "#065f46"],
    "Payment Pending" => ["#fef3c7", "#92400e"],
    "Paid"            => ["#dcfce7", "#166534"],
    "Overdue"         => ["#fce8e8", "#991b1b"],
  }
  bg, fg = inv_colors[st] || inv_colors["Submitted"]
  days = @po.days_until_due

  card  = "bg-white border border-[#e8e8e8] rounded-xl shadow-[2px_2px_10px_0px_rgba(156,153,153,0.25)]"
  label = "text-[11px] font-bold text-[#777] uppercase tracking-wide"

  # No Stripe yet. The invoice carries remit-to details instead of a pay button — this is
  # the block to replace when the integration lands.
  buyer_email = @po.invoice_sent_to&.first ||
                "#{@po.buyer_contact.to_s.downcase.gsub(' ', '.')}@#{@po.buyer_org.to_s.downcase.gsub(/[^a-z]/, '')}.edu"
%>

<div class="flex flex-1 min-h-0 bg-white font-['Lato']" data-controller="invoice">

  <%= render "shared/sidebar" %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">

    <%# ── Header + the two controls: Download, Email ──────────────────────── %>
    <div class="flex items-center justify-between px-4 md:px-9 py-4 border-b border-[#e8e8e8] bg-white shrink-0"
         data-invoice-target="chrome">
      <div class="flex items-center min-w-0" style="gap:12px;">
        <%= link_to vendor_invoices_path, title: "Back",
              data: { controller: "back", action: "click->back#go" },
              class: "no-min-h shrink-0 w-8 h-8 rounded-full flex items-center justify-center hover:bg-[#f0f0f0] transition-colors" do %>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M10 3L5 8l5 5" stroke="#1f1f1f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        <% end %>
        <h1 class="text-[16px] md:text-[20px] font-bold text-[#1f1f1f] truncate"><%= @po.invoice_number %></h1>
        <span class="inline-flex items-center whitespace-nowrap px-3 py-1 rounded-full text-[11px] font-bold shrink-0"
              style="background:<%= bg %>; color:<%= fg %>;"><%= st %></span>
      </div>

      <div class="flex items-center shrink-0" style="gap:10px;">
        <%# Download = print to PDF. Honest: the browser's own print dialog produces a real
            PDF, so there's no fake "generating…" spinner and no server-side PDF library. %>
        <button type="button" data-action="invoice#download"
                class="no-min-h inline-flex items-center gap-2 h-[38px] px-4 rounded-full text-[13px] font-bold text-[#1f1f1f] border border-[#a1a4aa] hover:border-[#1f1f1f] transition-colors">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="shrink-0">
            <path d="M7 1.5v8M3.8 6.6L7 9.8l3.2-3.2M2 12h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Download
        </button>

        <button type="button" data-action="invoice#openEmail" class="<%= primary_cta_class %>">
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" class="shrink-0">
            <rect x="1.2" y="2.8" width="11.6" height="8.4" rx="1.5" stroke="currentColor" stroke-width="1.4"/>
            <path d="M1.6 3.6L7 7.6l5.4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Email Invoice
        </button>
      </div>
    </div>

    <% if flash[:notice] %>
      <div class="px-4 md:px-9 py-2.5 border-b border-[#d4f5e9] shrink-0" data-invoice-target="chrome" style="background-color:#f0fbf7;">
        <p class="text-[12px] font-bold flex items-center gap-1.5" style="color:#065f46;">
          <span class="icon-check w-3 h-3 shrink-0"></span><%= flash[:notice] %>
        </p>
      </div>
    <% end %>

    <div class="flex-1 overflow-y-auto bg-[#f7f5ef] px-4 md:px-9 py-4 md:py-6">
      <div style="display:flex; gap:24px; align-items:flex-start; flex-wrap:wrap;">

        <%#
          ═══ THE INVOICE DOCUMENT ═══════════════════════════════════════════
          Deliberately paper-like: white, generous, quiet. It is the artifact the buyer's
          accounts-payable team will receive, so it should look like a document and not
          like an app screen.

          NOTHING HERE IS RE-KEYED. The line items, buyer, delivery location and totals ARE
          the purchase order. That's the whole reason there's no "create invoice" form:
          the order already said everything, so the invoice is generated FROM it.
        %>
        <div class="<%= card %>" style="flex:1 1 620px; min-width:0; padding:36px 32px;" data-invoice-target="paper">

          <div class="flex items-start justify-between" style="margin-bottom:32px;">
            <h2 class="text-[32px] font-bold text-[#1f1f1f]">Invoice</h2>
            <% if @vendor.logo.present? %>
              <img src="<%= @vendor.logo %>" alt="<%= @vendor.name %>"
                   class="object-contain shrink-0" style="width:48px; height:48px; border-radius:6px;">
            <% end %>
          </div>

          <%# From / To / Details — the Mercury three-column head. %>
          <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:24px; padding-bottom:24px; border-bottom:1px solid #e8e8e8;">
            <div>
              <p class="<%= label %>" style="margin-bottom:10px;">From</p>
              <p class="text-[13px] font-bold text-[#1f1f1f]"><%= @vendor.name %></p>
              <p class="text-[12px] text-[#777]"><%= @vendor.email %></p>
              <p class="text-[12px] text-[#777]" style="margin-top:6px;"><%= @vendor.address %></p>
            </div>

            <div>
              <p class="<%= label %>" style="margin-bottom:10px;">To</p>
              <p class="text-[13px] font-bold text-[#1f1f1f]"><%= @po.buyer_org %></p>
              <p class="text-[12px] text-[#777]"><%= @po.buyer_contact %></p>
              <p class="text-[12px] text-[#777]" style="margin-top:6px;"><%= @po.delivery_location %></p>
              <p class="text-[12px] text-[#777]"><%= @po.delivery_address %></p>
            </div>

            <div>
              <p class="<%= label %>" style="margin-bottom:10px;">Details</p>
              <div style="display:grid; grid-template-columns:auto 1fr; gap:4px 12px;">
                <span class="text-[12px] text-[#777]">Invoice no.</span>
                <span class="text-[12px] font-bold text-[#1f1f1f]"><%= @po.invoice_number %></span>
                <%# The PO number is the thread back to the order. An AP team lives by it. %>
                <span class="text-[12px] text-[#777]">PO no.</span>
                <span class="text-[12px] font-bold text-[#1f1f1f]"><%= @po.id %></span>
              </div>
            </div>
          </div>

          <%# Line items — straight from the PO. %>
          <div style="padding:24px 0;">
            <div style="display:grid; grid-template-columns:2.5fr 1fr 1fr 1fr; padding-bottom:10px; border-bottom:1px solid #e8e8e8;">
              <% ["Item", "Quantity", "Unit Price", "Total"].each_with_index do |h, i| %>
                <p class="<%= label %>" style="<%= 'text-align:right;' if i.positive? %>"><%= h %></p>
              <% end %>
            </div>

            <% @items.each do |li| %>
              <div style="display:grid; grid-template-columns:2.5fr 1fr 1fr 1fr; padding:12px 0; border-bottom:1px solid #f0f0f0;">
                <div style="min-width:0; padding-right:12px;">
                  <p class="text-[13px] text-[#1f1f1f]"><%= li.product&.name %></p>
                  <p class="text-[11px] text-[#a1a4aa]">
                    SKU <%= li.product_id %><%= " · UPC #{li.product.upc}" if li.product&.upc %>
                  </p>
                </div>
                <p class="text-[13px] text-[#444955]" style="text-align:right;"><%= li.quantity %> <%= li.unit %></p>
                <p class="text-[13px] text-[#444955]" style="text-align:right;">$<%= format("%.2f", li.unit_price.to_f) %></p>
                <p class="text-[13px] font-bold text-[#1f1f1f]" style="text-align:right;">$<%= format("%.2f", li.extended_cost) %></p>
              </div>
            <% end %>

            <%#
              Totals. NO Cureate processing fee — that's a buyer-side line (D2). This
              invoice is 2Betties billing the buyer for 2Betties' goods, and nothing else.
              Tax is a placeholder at 0% until the CEO tells us how food tax is handled.
            %>
            <div style="display:flex; justify-content:flex-end; padding-top:16px;">
              <div style="width:260px;">
                <div class="flex items-center justify-between" style="padding:6px 0;">
                  <span class="text-[13px] text-[#777]">Subtotal</span>
                  <span class="text-[13px] text-[#1f1f1f]">$<%= format("%.2f", @subtotal) %></span>
                </div>
                <div class="flex items-center justify-between" style="padding:6px 0;">
                  <span class="text-[13px] text-[#777]">Tax</span>
                  <span class="text-[13px] text-[#1f1f1f]">$0.00</span>
                </div>
                <div class="flex items-center justify-between" style="padding:12px 0 0; margin-top:6px; border-top:1px solid #e8e8e8;">
                  <span class="text-[15px] font-bold text-[#1f1f1f]">Total</span>
                  <span class="text-[22px] font-black text-[#1f1f1f]">$<%= format("%.2f", @subtotal) %></span>
                </div>
              </div>
            </div>
          </div>

          <%# Terms + Memo — Mercury's footer, and the place payment instructions live. %>
          <div style="display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:24px; padding-top:24px; border-top:1px solid #e8e8e8;">
            <div>
              <p class="<%= label %>" style="margin-bottom:10px;">Terms</p>
              <div style="display:grid; grid-template-columns:auto 1fr; gap:6px 14px;">
                <span class="text-[12px] text-[#777]">Invoice date</span>
                <span class="text-[12px] text-[#1f1f1f]"><%= format_delivery_date(@po.invoiced_at) %></span>

                <span class="text-[12px] text-[#777]">Due date</span>
                <span class="text-[12px] text-[#1f1f1f]">
                  <%= format_delivery_date(@po.invoice_due_date) %>
                  <% if days && !@po.invoice_paid? %>
                    <span style="color:<%= days.negative? ? '#991b1b' : '#a1a4aa' %>;">
                      (<%= days.negative? ? "#{days.abs} days late" : "in #{days} days" %>)
                    </span>
                  <% end %>
                </span>

                <span class="text-[12px] text-[#777]">Pay via</span>
                <span class="text-[12px] text-[#1f1f1f]"><%= @remit[:method] %></span>
              </div>

              <%#
                NO STRIPE YET. Instead of a pay button, the invoice carries the vendor's
                remit-to details — which is what a small food vendor actually does today.
                This block is the thing to replace when the integration lands.
              %>
              <div style="margin-top:16px; padding:12px 14px; border-radius:8px; background:#fafafa;">
                <p class="<%= label %>" style="margin-bottom:8px;">Remit To</p>
                <div style="display:grid; grid-template-columns:auto 1fr; gap:4px 12px;">
                  <span class="text-[11px] text-[#777]">Account name</span>
                  <span class="text-[11px] text-[#1f1f1f]"><%= @remit[:account_name] %></span>
                  <span class="text-[11px] text-[#777]">Bank</span>
                  <span class="text-[11px] text-[#1f1f1f]"><%= @remit[:bank] %></span>
                  <span class="text-[11px] text-[#777]">Account</span>
                  <span class="text-[11px] text-[#1f1f1f]" style="font-family:monospace;"><%= @remit[:account] %></span>
                  <span class="text-[11px] text-[#777]">Routing</span>
                  <span class="text-[11px] text-[#1f1f1f]" style="font-family:monospace;"><%= @remit[:routing] %></span>
                  <span class="text-[11px] text-[#777]">Terms</span>
                  <span class="text-[11px] text-[#1f1f1f]"><%= @remit[:terms] %></span>
                </div>
              </div>
            </div>

            <div>
              <p class="<%= label %>" style="margin-bottom:10px;">Memo</p>
              <p class="text-[12px] text-[#444955]" style="line-height:1.6;">
                <%= @po.invoice_memo.presence ||
                    "Thank you for your order. Please reference #{@po.invoice_number} with your payment." %>
              </p>
              <p class="text-[11px] text-[#a1a4aa]" style="margin-top:12px;">
                Delivered to <%= @po.delivery_location %> on <%= format_delivery_date(@po.delivery_date) %>.
              </p>
            </div>
          </div>
        </div>

        <%# ── Side rail: status, and who it's been sent to ─────────────────── %>
        <div style="flex:0 1 300px; min-width:260px;" data-invoice-target="chrome">
          <div class="<%= card %>" style="padding:16px;">
            <p class="<%= label %>" style="margin-bottom:10px;">Status</p>

            <p class="text-[26px] font-black text-[#1f1f1f]">$<%= format("%.2f", @subtotal) %></p>
            <p class="text-[12px] text-[#777]" style="margin-bottom:12px;">
              <% if @po.invoice_paid? %>
                Paid by <%= @po.buyer_org %>
              <% elsif days&.negative? %>
                <span style="color:#991b1b; font-weight:700;"><%= days.abs %> days overdue</span>
              <% else %>
                Due <%= format_delivery_date(@po.invoice_due_date) %>
              <% end %>
            </p>

            <div style="padding-top:12px; border-top:1px solid #f0f0f0;">
              <p class="<%= label %>" style="margin-bottom:8px;">Sent to</p>
              <% if @po.invoice_sent_to.present? %>
                <% Array(@po.invoice_sent_to).each do |addr| %>
                  <p class="text-[12px] text-[#444955]" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= addr %></p>
                <% end %>
                <p class="text-[11px] text-[#a1a4aa]" style="margin-top:4px;">
                  Sent <%= format_delivery_date(@po.invoice_sent_at) %>
                </p>
              <% else %>
                <p class="text-[12px] text-[#a1a4aa]">Not sent yet.</p>
              <% end %>
            </div>

            <%# Stripe is a future integration — say so plainly rather than showing a dead
                "Pay now" button that nobody can press. %>
            <div style="margin-top:14px; padding:10px 12px; border-radius:8px; background:#fafafa;">
              <p class="text-[11px] text-[#777]">
                <span class="font-bold text-[#444955]">Card payments coming soon.</span>
                Buyers pay by ACH or wire using the remit-to details on the invoice.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%# ── Email drawer ────────────────────────────────────────────────────────── %>
  <div data-invoice-target="backdrop" data-action="click->invoice#closeEmail"
       class="hidden fixed inset-0 bg-black/30 z-[70]"></div>

  <div data-invoice-target="emailPanel" data-open="false"
       class="fixed top-0 right-0 h-full z-[80] overflow-hidden bg-[#f7f5ef] font-['Lato'] flex flex-col"
       style="width:100%; max-width:460px; transform:translateX(100%); transition:transform 250ms ease;">
    <style>
      [data-invoice-target="emailPanel"][data-open="true"] { transform: translateX(0) !important; }
      @media print {
        /* Download = print to PDF. Everything except the document itself disappears. */
        aside, [data-invoice-target="chrome"], [data-invoice-target="emailPanel"],
        [data-invoice-target="backdrop"] { display: none !important; }
        [data-invoice-target="paper"] { box-shadow: none !important; border: none !important; }
        body { background: #fff !important; }
      }
    </style>

    <div class="flex items-center justify-between px-5 py-4 border-b border-[#e8e8e8] bg-white shrink-0">
      <div>
        <h2 class="text-[18px] font-bold text-[#1f1f1f]">Email Invoice</h2>
        <p class="text-[11px] text-[#777] mt-0.5"><%= @po.invoice_number %> · $<%= format("%.2f", @subtotal) %></p>
      </div>
      <button type="button" data-action="invoice#closeEmail"
              class="no-min-h w-9 h-9 flex items-center justify-center rounded-full hover:bg-[#f0f0f0] transition-colors">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M1 1l12 12M13 1L1 13" stroke="#1f1f1f" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <%= form_with(url: send_email_vendor_invoice_path(@po.id), method: :patch, local: true,
          class: "flex-1 flex flex-col min-h-0") do %>
      <div class="flex-1 overflow-y-auto px-5 py-4" style="display:flex; flex-direction:column; gap:14px;">
        <div class="bg-white border border-[#e8e8e8] rounded-xl" style="padding:16px;">
          <p class="<%= label %>" style="margin-bottom:8px;">To</p>
          <%= text_field_tag :recipients, buyer_email,
                class: "w-full h-[38px] rounded-lg border border-[#a1a4aa] px-3 text-[13px] text-[#444955] bg-white outline-none focus:border-[#28ba93] transition-colors" %>
          <p class="text-[11px] text-[#a1a4aa] mt-1.5">Separate multiple addresses with a comma.</p>
        </div>

        <div class="bg-white border border-[#e8e8e8] rounded-xl" style="padding:16px;">
          <p class="<%= label %>" style="margin-bottom:8px;">Memo</p>
          <%= text_area_tag :memo, @po.invoice_memo, rows: 4,
                placeholder: "Add a note for the buyer's accounts team…",
                class: "w-full rounded-lg border border-[#a1a4aa] px-3 py-2 text-[13px] text-[#444955] bg-white outline-none focus:border-[#28ba93] transition-colors" %>
          <p class="text-[11px] text-[#a1a4aa] mt-1.5">This appears on the invoice itself.</p>
        </div>

        <p class="text-[11px] text-[#a1a4aa]" style="padding:0 4px;">
          The invoice PDF and your remit-to details are attached automatically.
        </p>
      </div>

      <div class="shrink-0 px-5 py-4 border-t border-[#e8e8e8] bg-white">
        <%= submit_tag "Send Invoice",
              class: "no-min-h w-full h-[44px] rounded-full text-[13px] font-bold text-white bg-[#28ba93] hover:bg-[#22a882] transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
