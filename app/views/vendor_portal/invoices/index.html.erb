<% content_for :title, "Invoices — 2Betties · Cureate Connect" %>
<%
  card = "bg-white border border-[#e8e8e8] rounded-xl"

  # Invoice status colors. Overdue is the only red — it's the only one that means someone
  # owes the vendor money and is late with it.
  inv_colors = {
    "Submitted"       => ["#f0f0f0", "#444955"],
    "Approved"        => ["#d4f5e9", "#065f46"],
    "Payment Pending" => ["#fef3c7", "#92400e"],
    "Paid"            => ["#dcfce7", "#166534"],
    "Overdue"         => ["#fce8e8", "#991b1b"],
  }
%>

<div class="flex flex-1 min-h-0 bg-white font-['Lato']">

  <%= render "shared/sidebar" %>

  <div class="flex-1 flex flex-col overflow-hidden min-w-0">

    <div class="flex items-center justify-between px-4 md:px-9 py-4 border-b border-[#e8e8e8] bg-white shrink-0">
      <h1 class="text-[20px] font-bold text-[#1f1f1f]">Invoices</h1>
    </div>

    <% if flash[:notice] %>
      <div class="px-4 md:px-9 py-2.5 border-b border-[#d4f5e9] shrink-0" style="background-color:#f0fbf7;">
        <p class="text-[12px] font-bold flex items-center gap-1.5" style="color:#065f46;">
          <span class="icon-check w-3 h-3 shrink-0"></span><%= flash[:notice] %>
        </p>
      </div>
    <% end %>

    <div class="flex-1 overflow-y-auto bg-[#f7f5ef] px-4 md:px-9 py-4 md:py-6">

      <%#
        ── Cash flow ───────────────────────────────────────────────────────────
        The PRD's own words: "Cash flow visibility is a top vendor concern." So the three
        numbers come first and the list comes second. A vendor opens this page to answer
        "when do I get paid?", not to browse documents.
      %>
      <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px, 1fr)); gap:16px; margin-bottom:24px;">
        <div class="<%= card %>" style="padding:16px;">
          <p class="text-[26px] font-black text-[#1f1f1f]">$<%= number_with_delimiter(@open_total.round) %></p>
          <p class="text-[13px] font-bold text-[#444955]" style="margin-top:2px;">Outstanding</p>
          <p class="text-[11px] text-[#a1a4aa]"><%= pluralize(@open_count, "invoice") %> awaiting payment</p>
        </div>

        <div class="<%= card %>" style="padding:16px; <%= 'border-color:#f0dede;' if @overdue_count.positive? %>">
          <p class="text-[26px] font-black" style="color:<%= @overdue_count.positive? ? '#991b1b' : '#1f1f1f' %>;">
            $<%= number_with_delimiter(@overdue_total.round) %>
          </p>
          <p class="text-[13px] font-bold text-[#444955]" style="margin-top:2px;">Overdue</p>
          <p class="text-[11px] text-[#a1a4aa]"><%= pluralize(@overdue_count, "invoice") %> past the due date</p>
        </div>

        <div class="<%= card %>" style="padding:16px;">
          <p class="text-[26px] font-black text-[#1f1f1f]">$<%= number_with_delimiter(@paid_total.round) %></p>
          <p class="text-[13px] font-bold text-[#444955]" style="margin-top:2px;">Paid</p>
          <p class="text-[11px] text-[#a1a4aa]"><%= pluralize(@paid_count, "invoice") %> settled</p>
        </div>
      </div>

      <%#
        Money the vendor hasn't asked for yet. Not in the PRD, but "cash flow visibility"
        that ignores un-billed revenue isn't visibility. These orders are fulfilled and
        accepted — the vendor just hasn't pressed the button.
      %>
      <% if @uninvoiced.any? %>
        <div class="flex flex-wrap items-center rounded-xl border border-[#e8e8e8] bg-white"
             style="gap:12px; padding:12px 16px; margin-bottom:24px;">
          <p class="text-[13px] text-[#1f1f1f]" style="min-width:0;">
            <span class="font-bold">
              <%= pluralize(@uninvoiced.size, "delivered order") %> ready to invoice
              — $<%= number_with_delimiter(@uninvoiced_total.round) %>
            </span>
            <span class="text-[#777]">You haven't billed for these yet.</span>
          </p>
          <%= link_to "Review Orders", vendor_orders_path(tab: "fulfillment"),
                class: "no-min-h ml-auto shrink-0 h-[32px] px-4 rounded-full text-[12px] font-bold text-white bg-[#1f1f1f] hover:bg-[#363636] transition-colors flex items-center" %>
        </div>
      <% end %>

      <%# ── Filter tabs ───────────────────────────────────────────────────── %>
      <div class="flex items-center flex-wrap" style="gap:4px; margin-bottom:14px;">
        <% VendorPortal::InvoicesController::TABS.each do |tab| %>
          <% active = @filter == tab %>
          <%= link_to vendor_invoices_path(filter: tab),
                class: "no-min-h px-4 h-[32px] rounded-full text-[12px] font-bold whitespace-nowrap flex items-center transition-colors #{active ? 'bg-[#1f1f1f] text-white' : 'text-[#777] hover:text-[#1f1f1f] hover:bg-[#f0f0f0]'}",
                style: "gap:6px;" do %>
            <span><%= tab %></span>
            <% if @counts[tab].to_i.positive? %>
              <span class="text-[10px] font-black px-1.5 py-0.5 rounded-full <%= active ? 'bg-white/20 text-white' : 'bg-[#e8e8e8] text-[#555]' %>"><%= @counts[tab] %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>

      <%# ── The list ──────────────────────────────────────────────────────── %>
      <div class="<%= card %> overflow-hidden">
        <% if @invoices.empty? %>
          <div class="py-16 text-center">
            <p class="text-[14px] font-bold text-[#444955]">No invoices here</p>
            <p class="text-[12px] text-[#777] mt-1">Invoices are generated from an order once it's delivered and accepted.</p>
          </div>
        <% else %>
          <table style="width:100%; table-layout:fixed;">
            <colgroup>
              <col style="width:150px">  <%# Due date %>
              <col style="width:150px">  <%# Status %>
              <col>                      <%# Buyer %>
              <col style="width:130px">  <%# Invoice no. %>
              <col style="width:130px">  <%# Invoice date %>
              <col style="width:130px">  <%# Amount %>
            </colgroup>
            <thead>
              <tr class="border-b border-[#e8e8e8]" style="background:#fafafa;">
                <th style="width:150px" class="text-left px-5 py-2.5 text-[11px] font-bold text-[#777] uppercase tracking-wide">Due Date</th>
                <th style="width:150px" class="text-left px-4 py-2.5 text-[11px] font-bold text-[#777] uppercase tracking-wide">Status</th>
                <th class="text-left px-4 py-2.5 text-[11px] font-bold text-[#777] uppercase tracking-wide">Buyer</th>
                <th style="width:130px" class="text-left px-4 py-2.5 text-[11px] font-bold text-[#777] uppercase tracking-wide">Invoice No.</th>
                <th style="width:130px" class="text-left px-4 py-2.5 text-[11px] font-bold text-[#777] uppercase tracking-wide">Invoice Date</th>
                <th style="width:130px" class="text-right px-5 py-2.5 text-[11px] font-bold text-[#777] uppercase tracking-wide">Amount</th>
              </tr>
            </thead>
            <tbody>
              <% @invoices.each do |po| %>
                <%
                  st = po.invoice_display_status
                  bg, fg = inv_colors[st] || inv_colors["Submitted"]
                  days = po.days_until_due
                %>
                <tr data-controller="row-link"
                    data-row-link-url-value="<%= vendor_invoice_path(po.id) %>"
                    data-action="click->row-link#go"
                    class="border-b border-[#f0f0f0] hover:bg-[#f7f5ef] cursor-pointer transition-colors">

                  <td class="px-5 py-3.5" style="overflow:hidden;">
                    <p class="text-[13px] font-bold text-[#1f1f1f]" style="white-space:nowrap;">
                      <%= format_delivery_date(po.invoice_due_date).sub(/, \d{4}\z/, "") %>
                    </p>
                    <%# The human number: not the date, but how long until it bites. %>
                    <% if days && !po.invoice_paid? %>
                      <p class="text-[11px]" style="white-space:nowrap; color:<%= days.negative? ? '#991b1b' : '#a1a4aa' %>;">
                        <%= days.negative? ? "#{days.abs} days late" : (days.zero? ? "due today" : "in #{days} days") %>
                      </p>
                    <% end %>
                  </td>

                  <td class="px-4 py-3.5" style="overflow:hidden;">
                    <span class="inline-flex items-center whitespace-nowrap px-3 py-1 rounded-full text-[11px] font-bold"
                          style="background:<%= bg %>; color:<%= fg %>;"><%= st %></span>
                  </td>

                  <td class="px-4 py-3.5" style="overflow:hidden;">
                    <p class="text-[13px] text-[#1f1f1f]" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= po.buyer_org %></p>
                    <p class="text-[11px] text-[#777]" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= po.delivery_location %></p>
                  </td>

                  <td class="px-4 py-3.5" style="overflow:hidden;">
                    <span class="text-[13px] font-bold text-[#28ba93]" style="white-space:nowrap;"><%= po.invoice_number %></span>
                  </td>

                  <td class="px-4 py-3.5" style="overflow:hidden;">
                    <span class="text-[13px] text-[#444955]" style="white-space:nowrap;">
                      <%= format_delivery_date(po.invoiced_at).sub(/, \d{4}\z/, "") %>
                    </span>
                  </td>

                  <td class="px-5 py-3.5 text-right" style="overflow:hidden;">
                    <span class="text-[14px] font-black text-[#1f1f1f]" style="white-space:nowrap;">
                      $<%= format("%.2f", po.vendor_subtotal(@vendor.id)) %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>
  </div>
</div>
