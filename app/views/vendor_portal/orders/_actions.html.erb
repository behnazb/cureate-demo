<%#
  The vendor's lifecycle actions (E1/E3).

  Exactly ONE action is offered at a time, because only one is legal:

    Requested   → Confirm            (or Decline, with a reason)
    Confirmed   → Mark as fulfilled  → Delivery | Shipping (+ carrier, tracking)
    Fulfillment → Issue invoice      (locked until proven AND the buyer's 24h window closes)
    Invoiced    → nothing. Frozen.
    Paid        → nothing. The buyer paid.
    Cancelled   → nothing. Shows why.

  The panel never presents a button the vendor can't legally press. When invoicing is
  blocked, it says WHY in the vendor's own terms rather than greying out silently.

  Locals: po, vendor
%>
<%
  status  = po.status
  can_inv = po.can_invoice?(vendor.id)
  blocked = po.invoice_blocked_reason(vendor.id)

  # A LOCAL, not a constant. ERB templates compile into a method, so `FOO = [...]`
  # here is a dynamic constant assignment — a Ruby SyntaxError at render time.
  decline_reasons = [
    "Out of stock",
    "Can't meet the delivery date",
    "Minimum order not met",
    "Other",
  ]
%>

<%# Same card treatment as the buyer's PO detail page: white, hairline border, and the
    2px/10px soft shadow that lifts it off the warm canvas. %>
<div class="bg-white border border-[#e8e8e8] rounded-xl shadow-[2px_2px_10px_0px_rgba(156,153,153,0.25)] overflow-hidden"
     data-controller="order-actions">

  <%# ── REQUESTED — confirm or decline ─────────────────────────────────────── %>
  <% if status == "Processing" %>
    <div class="px-5 py-4 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <h2 class="text-[14px] font-bold text-[#1f1f1f]">New request from <%= po.buyer_org %></h2>
        <p class="text-[12px] text-[#777] mt-0.5">
          Confirm if you have the stock and can hit <%= format_delivery_date(po.delivery_date) %>.
        </p>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <button type="button" data-action="order-actions#toggleDecline"
                class="no-min-h h-[38px] px-4 rounded-full text-[13px] font-bold text-[#777] border border-[#a1a4aa] hover:border-[#991b1b] hover:text-[#991b1b] transition-colors">
          Decline
        </button>
        <%= button_to "Confirm order", confirm_vendor_order_path(po.id), method: :patch,
              class: "no-min-h h-[38px] px-5 rounded-full text-[13px] font-bold text-white bg-[#28ba93] hover:bg-[#22a882] transition-colors" %>
      </div>
    </div>

    <%# Decline — a reason is required, so Cureate and the buyer know what went wrong. %>
    <div data-order-actions-target="declinePanel" class="hidden px-5 pb-5 pt-1 border-t border-[#f0f0f0]">
      <%= form_with(url: decline_vendor_order_path(po.id), method: :patch, local: true) do %>
        <p class="text-[12px] font-bold text-[#1f1f1f] mt-4 mb-2.5">Why are you declining?</p>
        <div class="flex flex-col gap-1.5 mb-3">
          <% decline_reasons.each_with_index do |reason, i| %>
            <label class="flex items-center gap-2.5 cursor-pointer group">
              <%= radio_button_tag :reason, reason, i.zero?, id: nil,
                    class: "accent-[#28ba93]" %>
              <span class="text-[13px] text-[#444955] group-hover:text-[#1f1f1f]"><%= reason %></span>
            </label>
          <% end %>
        </div>
        <%= text_field_tag :note, nil, placeholder: "Anything Cureate should tell the buyer? (optional)",
              class: "w-full h-[38px] rounded-lg border border-[#a1a4aa] px-3 text-[13px] text-[#444955] outline-none focus:border-[#1f1f1f] transition-colors mb-3" %>
        <%= submit_tag "Decline order",
              class: "no-min-h h-[38px] px-5 rounded-full text-[13px] font-bold text-white cursor-pointer transition-colors",
              style: "background-color:#991b1b;" %>
      <% end %>
    </div>

  <%# ── CONFIRMED — commit to how it goes out ──────────────────────────────── %>
  <% elsif status == "Confirmed" %>
    <div class="px-5 py-4 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <h2 class="text-[14px] font-bold text-[#1f1f1f]">Confirmed for <%= format_delivery_date(po.delivery_date) %></h2>
        <p class="text-[12px] text-[#777] mt-0.5">
          When it's ready to go out, tell us how it's being fulfilled.
        </p>
      </div>
      <%= button_tag type: "button", data: { action: "order-actions#toggleFulfill" },
            class: "no-min-h shrink-0 h-[38px] px-5 rounded-full text-[13px] font-bold text-white bg-[#28ba93] hover:bg-[#22a882] transition-colors" do %>
        Mark as fulfilled
      <% end %>
    </div>

    <div data-order-actions-target="fulfillPanel" class="hidden px-5 pb-5 border-t border-[#f0f0f0]">
      <%= form_with(url: fulfill_vendor_order_path(po.id), method: :patch, local: true) do %>

        <p class="text-[12px] font-bold text-[#1f1f1f] mt-4 mb-2.5">How is this order being fulfilled?</p>

        <%# The same two choices the mobile ingestion app offers the floor team. %>
        <div class="grid grid-cols-2 gap-3 mb-4">
          <label data-method-card="Delivery"
                 class="cursor-pointer rounded-lg border p-3.5 transition-colors"
                 style="border-color:#e8e8e8; background-color:#ffffff;">
            <%= radio_button_tag :method_choice, "Delivery", false, id: nil,
                  data: { action: "order-actions#chooseMethod", order_actions_target: "methodInput" },
                  class: "hidden" %>
            <p class="text-[13px] font-bold text-[#1f1f1f] mb-0.5">🚚 Truck Delivery</p>
            <p class="text-[11px] text-[#777] leading-snug">
              We deliver it. The driver photographs the drop-off as proof.
            </p>
          </label>

          <label data-method-card="Shipping"
                 class="cursor-pointer rounded-lg border p-3.5 transition-colors"
                 style="border-color:#e8e8e8; background-color:#ffffff;">
            <%= radio_button_tag :method_choice, "Shipping", false, id: nil,
                  data: { action: "order-actions#chooseMethod", order_actions_target: "methodInput" },
                  class: "hidden" %>
            <p class="text-[13px] font-bold text-[#1f1f1f] mb-0.5">📦 Shipping</p>
            <p class="text-[11px] text-[#777] leading-snug">
              A carrier takes it. The tracking code is the proof.
            </p>
          </label>
        </div>

        <%# Handling requirement — same picker as the ingestion app, text only. %>
        <p class="text-[12px] font-bold text-[#1f1f1f] mb-2">Handling</p>
        <div class="flex flex-wrap gap-2 mb-4">
          <% %w[Ambient Cold Frozen Warm].each_with_index do |h, i| %>
            <label class="cursor-pointer">
              <%= radio_button_tag :handling, h, i.zero?, id: nil, class: "hidden peer" %>
              <span class="inline-flex items-center px-4 h-[32px] rounded-full border border-[#a1a4aa] text-[12px] font-bold text-[#444955] peer-checked:border-[#28ba93] peer-checked:bg-[#f0fbf7] peer-checked:text-[#065f46] transition-colors">
                <%= h %>
              </span>
            </label>
          <% end %>
        </div>

        <%# Shipping only — carrier + tracking. Deferring is allowed, exactly as the
            mobile app allows "Add Later"; the order then shows ⚠ Tracking Needed. %>
        <div data-order-actions-target="shippingFields" class="hidden mb-4">
          <p class="text-[12px] font-bold text-[#1f1f1f] mb-2">Carrier</p>
          <div class="flex flex-wrap gap-2 mb-3">
            <% %w[UPS FedEx USPS].each_with_index do |c, i| %>
              <label class="cursor-pointer">
                <%= radio_button_tag :carrier, c, i.zero?, id: nil, class: "hidden peer" %>
                <span class="inline-flex items-center px-4 h-[32px] rounded-full border border-[#a1a4aa] text-[12px] font-bold text-[#444955] peer-checked:border-[#28ba93] peer-checked:bg-[#f0fbf7] peer-checked:text-[#065f46] transition-colors">
                  <%= c %>
                </span>
              </label>
            <% end %>
          </div>

          <p class="text-[12px] font-bold text-[#1f1f1f] mb-2">Tracking number</p>
          <%= text_field_tag :tracking, nil, placeholder: "e.g. 1Z999AA10123456784", autocomplete: "off",
                class: "w-full h-[38px] rounded-lg border border-[#a1a4aa] px-3 text-[13px] text-[#444955] outline-none focus:border-[#1f1f1f] transition-colors" %>
          <p class="text-[11px] text-[#a1a4aa] mt-1.5">
            Don't have it yet? Leave it blank and add it later — the order will show
            <span class="font-bold" style="color:#991b1b;">Tracking Needed</span> until you do.
          </p>
        </div>

        <%= submit_tag "Mark as fulfilled", disabled: true,
              data: { order_actions_target: "submitFulfill" },
              class: "no-min-h h-[38px] px-5 rounded-full text-[13px] font-bold text-white bg-[#28ba93] hover:bg-[#22a882] transition-colors cursor-pointer opacity-40 cursor-not-allowed" %>
      <% end %>
    </div>

  <%# ── FULFILLMENT — invoice, once it's earned ────────────────────────────── %>
  <% elsif status == "Delivered" %>
    <div class="px-5 py-4 flex flex-col md:flex-row md:items-center gap-4">
      <div class="flex-1">
        <h2 class="text-[14px] font-bold text-[#1f1f1f]">
          <%= can_inv ? "Ready to invoice" : "Fulfillment in progress" %>
        </h2>
        <p class="text-[12px] mt-0.5 <%= can_inv ? 'text-[#777]' : 'text-[#991b1b]' %>">
          <%= can_inv ? "#{po.buyer_org} accepted the delivery. Issuing the invoice locks this order." : blocked %>
        </p>
      </div>

      <% if can_inv %>
        <%= button_to "Issue invoice", invoice_vendor_order_path(po.id), method: :patch,
              class: "no-min-h shrink-0 h-[38px] px-5 rounded-full text-[13px] font-bold text-white bg-[#28ba93] hover:bg-[#22a882] transition-colors" %>
      <% else %>
        <%# Present but visibly unavailable — the vendor can see where this is going,
            and the sentence above tells them what has to happen first. %>
        <span class="shrink-0 h-[38px] px-5 rounded-full text-[13px] font-bold text-[#a1a4aa] bg-[#f4f4f4] flex items-center cursor-not-allowed"
              title="<%= blocked %>">
          Issue invoice
        </span>
      <% end %>
    </div>

  <%# ── INVOICED — frozen, awaiting payment ────────────────────────────────── %>
  <% elsif status == "Invoiced" %>
    <div class="px-5 py-4 flex items-center gap-3">
      <span class="text-[14px]">🔒</span>
      <div>
        <h2 class="text-[14px] font-bold text-[#1f1f1f]">
          Invoice issued to <%= po.buyer_org %><%= " · #{po.invoiced_at}" if po.invoiced_at %>
        </h2>
        <%# The order IS locked in the UI, but a vendor is never left at a dead end —
            there's a human who can unlock it. %>
        <p class="text-[12px] text-[#777] mt-0.5">
          Awaiting payment. If you need to make a change or edit your invoice, contact your Cureate team rep.
        </p>
      </div>
    </div>

  <%# ── PAID ───────────────────────────────────────────────────────────────── %>
  <% elsif status == "Paid" %>
    <div class="px-5 py-4 flex items-center gap-3">
      <%= success_chip("Paid") %>
      <p class="text-[12px] text-[#777]">
        <%= po.buyer_org %> paid this invoice. Nothing more to do.
      </p>
    </div>

  <%# ── CANCELLED ──────────────────────────────────────────────────────────── %>
  <% elsif status == "Cancelled" %>
    <div class="px-5 py-4">
      <div class="flex items-center gap-2.5">
        <%= warning_chip("Cancelled") %>
        <% if po.decline_reason %>
          <span class="text-[12px] font-bold text-[#444955]"><%= po.decline_reason %></span>
        <% end %>
      </div>
      <% if po.decline_note.present? %>
        <p class="text-[12px] text-[#777] mt-2">“<%= po.decline_note %>”</p>
      <% end %>
    </div>
  <% end %>
</div>
