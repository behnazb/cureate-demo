<% content_for :title, "Something went wrong" %>
<div class="flex-1 bg-white flex items-center justify-center px-6">
  <div class="text-center">
    <div class="w-12 h-12 bg-[#fde8dc] rounded-full flex items-center justify-center mx-auto mb-4">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <path d="M10 6v4M10 14h.01" stroke="#a33500" stroke-width="2" stroke-linecap="round"/>
        <circle cx="10" cy="10" r="9" stroke="#a33500" stroke-width="1.5"/>
      </svg>
    </div>
    <h2 class="text-[18px] font-bold text-[#1f1f1f] mb-2">Something went wrong</h2>
    <p class="text-[13px] text-[#777] mb-6 max-w-[280px] mx-auto">An unexpected error occurred. Please try again.</p>
    <%= link_to "Try again", request.referer || root_path,
        class: "bg-[#28ba93] text-white font-bold text-[13px] rounded-full px-6 h-[38px] inline-flex items-center hover:bg-[#22a882] transition-colors no-min-h" %>
  </div>
</div>
